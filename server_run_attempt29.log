### Mechanic: Puck Object Pool & Physics Init
INTENT: Initialize the puck object pool with randomized counter-weight spring tension and register the physics step callback.
PSEUDO:
  CreatePool("puck", 2, 0, {mass = 2.5, restitution = 0.4, friction = 0.3})
  OnStep(function(dt)
    local puck = PoolAcquire("puck", 0, 0, 0)
    if puck then
      local tension = math.random(0.5, 1.5)
      SetMass(puck, 2.5 * tension)
      SetRestitution(puck, 0.4)
      SetFriction(puck, 0.3)
      PoolReturn("puck", puck)
    end
  end)
