    -- [TASK_9_INSERT_HOOK] -- dynamic difficulty tuning: recompute heat/luck/sleight-of-hand from current streak on score events
    -- Implement lever tension spring physics: calculate counter-weight force based on lever angle and mass properties
    local lever_angle = self.Lever:GetAngle()
    local lever_pivot = self.Lever:GetPivotPoint()
    local counter_weight = self.CounterWeight
    local spring_anchor = self.SpringAnchor
    
    if not counter_weight or not spring_anchor then return end
    
    -- Calculate lever arm lengths from pivot
    local lever_arm_length = self.Lever:GetLength()
    local counter_weight_arm_length = self.CounterWeight:GetDistanceFromPivot(lever_pivot)
    
    -- Calculate torque from counter-weight (restoring force)
    local counter_weight_mass = counter_weight:GetMass()
    local gravity = 9.81
    local counter_weight_torque = counter_weight_mass * gravity * counter_weight_arm_length * math.sin(math.rad(lever_angle))
    
    -- Calculate spring force (Hooke's Law: F = k * x)
    local spring_stiffness = self.SpringStiffness or 5000 -- N/m
    local spring_rest_length = self.SpringRestLength or 0.5 -- meters
    local current_spring_length = self.Spring:GetCurrentLength()
    local spring_displacement = current_spring_length - spring_rest_length
    local spring_force = spring_stiffness * spring_displacement
    
    -- Calculate net force on lever
    local net_torque = counter_weight_torque + spring_force * lever_arm_length
    
    -- Apply dynamic difficulty tuning based on current streak
    local current_streak = Engine.GetStreak()
    local difficulty_multiplier = 1.0 + (current_streak * 0.05) -- Increase difficulty by 5% per streak
    
    -- Adjust spring stiffness dynamically
    local adjusted_spring_stiffness = spring_stiffness * difficulty_multiplier
    local adjusted_spring_force = adjusted_spring_stiffness * spring_displacement
    local adjusted_net_torque = counter_weight_torque + adjusted_spring_force * lever_arm_length
    
    -- Apply this torque to the lever
    self.Lever:SetTorque(adjusted_net_torque)
    
    -- Log for debugging
    if self.DebugMode then
        print(string.format("Lever Torque: %.2f Nm, Spring Force: %.2f N, Counter-weight Torque: %.2f Nm", 
            adjusted_net_torque, adjusted_spring_force, counter_weight_torque))
    end
    -- [TASK_9_INSERT_HOOK] -- dynamic difficulty tuning: recompute heat/luck/sleight-of-hand from current streak on score events
