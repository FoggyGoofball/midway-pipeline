            local current_pos = tostring(lx) .. "," .. tostring(ly) .. "," .. tostring(lz)

            if last_hit_pos and current_pos == last_hit_pos then
                echo_counter = echo_counter + 1
                if echo_counter >= 3 then
                    launch_ready = true
                end
            else
                last_hit_pos = current_pos
            end
