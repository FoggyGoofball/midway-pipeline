### Mechanic: Echo Strikes rhythm
INTENT: multiplies ticket payout by incrementing a counter only when the puck lands on the same bell zone within a strict time window
PSEUDO:
  if IsSensorTriggered(sensor_hit_zone) then
    zone = GetPosition(sensor_hit_zone).y
    now = Engine.GetTime()
    if now < last_hit_time + RHYTHM_WINDOW then
      if zone == last_hit_zone then
        echo_strike_count = echo_strike_count + 1
      else
        echo_strike_count = 1
      end
    else
      echo_strike_count = 1
    end
    last_hit_zone = zone
    last_hit_time = now
    reward = BaseReward * (1 + (echo_strike_count - 1) * RHYTHM_BONUS)
    Engine.AwardTickets(reward, "Echo Strike")
  end
