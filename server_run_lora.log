        -0.1,
        -0.4,
        SharedBooth.HalfDepthZ(),
        SharedBooth.WidthX(), 
        0.8, 
        SharedBooth.DepthZ()
    )
end

function OnLoad()
    Mods.ReadModifiers()

    local mods = AttractionConstants.modifiers
    if math.random() < mods.luck then
        Engine.AwardTickets(math.floor(mods.karma * 3) + 10, "LUCK_BONUS")
    end

    if mods.nerve > 0.7 then
        shock_plate_cooldown = 2.0
    end

    MidwayPhysics.OnStep(function(dt)
        local mods = AttractionConstants.modifiers
        
        if mods.rusty_rails then
            MidwayPhysics.SetFriction(puck_handle, 0.9)
        end

        if mods.weighted_puck then
            MidwayPhysics.SetMass(puck_handle, 2.0)
        end

        if mods.cracked_base > 0.5 then
            -- Do nothing for now
        end
    end)
end

function OnUnload()
    local total, free = MidwayPhysics.PoolTotal('puck_pool'), MidwayPhysics.PoolFree('puck_pool')
    
    print(string.format("Puck Pool: Total=%d | Free=%d", total, free))

    if mallet_handle     then MidwayPhysics.DestroyBody(mallet_handle)      end
    if puck_handle       then MidwayPhysics.DestroyBody(puck_handle)         end
    if bell_handle       then MidwayPhysics.MoveKinematic(bell_handle, 0.0, -2.0, 0.0, dt or 1/60) end
    if platform_handle   then MidwayPhysics.SetRestitution(platform_handle, math.huge) end
    
    shock_plate_cooldown = 0.0
end
