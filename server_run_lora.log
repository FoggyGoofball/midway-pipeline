function OnLoadStatic()
    SpawnSharedBooth()

    local h0 = MidwayPhysics.SpawnStaticCapsule(2.769, 1.0, -0.9, 0.2, 0.6)
    local h1 = MidwayPhysics.SpawnDynamicSphere(-0.2, 1.0, -0.3, 0.3)
    local h2 = MidwayPhysics.SpawnSensorBox(0.5, 1.1, -1.7, 0.2, 0.6, 1.5)

