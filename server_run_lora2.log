-- Register the per-frame callback
MidwayPhysics.OnStep(function(dt)
    local MOD = AttractionConstants.modifiers
    local luckMult = 1.2 + (MOD.luck * 0.4)

    local h_sensor = MidwayPhysics.SpawnSensorBox(0, 0.8, -2.6, 1.7, 1.8, 1.9)
