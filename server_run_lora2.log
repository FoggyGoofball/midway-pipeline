        Engine.AwardTickets(math.floor(streak_mult), 'WIN')
        Engine.AwardTokens(math.floor(luckMult * streak_mult), 'BONUS')

        tickets_awarded_this_step = true
    end
    
    MidwayPhysics.DestroyBody(h_sensor)
