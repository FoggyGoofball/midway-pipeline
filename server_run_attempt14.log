    -- Tower Gauge Shift: detect bell collision, destroy puck, respawn at new height
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local bell_pos_x, bell_pos_y, bell_pos_z = MidwayPhysics.GetPosition(bell)
        local puck_pos_x, puck_pos_y, puck_pos_z = MidwayPhysics.GetPosition(puck)
        
        -- Check if puck reached bell height (triggered by bell sensor or collision)
        if puck_pos_z >= bell_pos_z then
            -- Destroy old puck
            MidwayPhysics.DestroyBody(puck)
            puck = nil
            
            -- Apply Tower Gauge Shift: spawn new puck at random height near bell
            local random_height = bell_pos_z + (math.random() - 0.5) * 2.0
            local new_puck = MidwayPhysics.PoolAcquire(puck_pool, 0.0, random_height, 0.0)
            puck = new_puck
            
            -- Apply dynamic friction based on modifier
            MidwayPhysics.SetFriction(puck, 0.5 * (1.0 + MOD.heat * 0.2))
        end
        
        -- Check bell collision for win condition
        if IsSensorTriggered(counter_spring) then
            local bell_pos_x, bell_pos_y, bell_pos_z = MidwayPhysics.GetPosition(bell)
            local puck_pos_x, puck_pos_y, puck_pos_z = MidwayPhysics.GetPosition(puck)
            
            -- Check if puck hit bell (within radius)
            local dx = puck_pos_x - bell_pos_x
            local dy = puck_pos_y - bell_pos_y
            local dz = puck_pos_z - bell_pos_z
            local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
            
            if dist < 1.0 then
                -- Award economy
                local streak = Engine.GetStreak()
                Engine.AwardTickets(10 * streak, 'WIN')
                Engine.AwardTokens(5 * streak, 'BONUS')
                
                -- Reset streak wager
                streak_wager = 0
                
                -- Reset bell height for next round
                bell_height_offset = 0
                
                -- Destroy puck after win
                MidwayPhysics.DestroyBody(puck)
                puck = nil
            end
        end
    end)
