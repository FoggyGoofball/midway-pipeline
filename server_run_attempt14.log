### Mechanic: Initialization & Pooling
INTENT: Spawn persistent environment objects, create a single puck pool, register the physics step callback, and reset all game state counters.
PSEUDO:
  platform = SpawnStaticBox(0, 0, 0, 10, 1, 10)
  lever = SpawnStaticBox(0, 0, 2, 1, 0.5, 0.5)
  bell = SpawnStaticSphere(0, 0, 5, 0.5)
  rusty_rails = SpawnKinematicBox(0, 0, 1, 2, 1, 1)
  counter_spring = SpawnSensorBox(0, 0, 3, 1, 1, 1)
  puck = CreatePool('puck', 1, 1, {mass = 1})
  mallet = SpawnDynamicBox(0, 0, -2, 1, 1, 1)
  OnStep(function(dt)
    if MidwayInput.IsActionDown('fire') then
      ApplyImpulse(mallet, 0, 0, -10)
    end
    if IsSensorTriggered(counter_spring) then
      ApplyAngularImpulse(lever, 0, 0, 1)
    end
    local pos = GetPosition(puck)
    if pos.z >= bell.y then
      Engine.AwardTickets(10, 'high_strike')
      Engine.AwardTokens(1, 'streak')
      DestroyBody(puck)
      MoveKinematic(bell, 0, pos.z + 0.5, 0, dt)
    end
  end)
  streak_wager = 0
  bell_height_offset = 0
  mallet_integrity = 1.0
  echo_streak = 0
  platform_wobble = 0
  spring_tension = 1.0
