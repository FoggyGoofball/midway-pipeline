function OnLoad()
    -- Shared constants table (geometry, physics, gameplay values)
    local MOD = AttractionConstants.modifiers
    local puck_pool = MidwayPhysics.CreatePool("puck_pool", 1, 1, {
        radius = 0.5,
        mass = 1.0,
        restitution = 0.5,
        friction = 0.2,
        gravityFactor = 1.0,
        linearDamping = 0.1,
        angularDamping = 0.1,
    })
    
    -- Spawn initial puck
    local puck = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, 0.5, 1.0)
    puck_pool = MidwayPhysics.PoolReturn("puck_pool", puck)
    
    -- Register per-step callback
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local bell_pos_x = 5.0
        
        -- Check for bell collision
        if MidwayPhysics.IsSensorTriggered(puck) then
            MidwayPhysics.DestroyBody(puck)
            -- Respawn puck at new height
            puck = MidwayPhysics.PoolAcquire("puck_pool", 0, 0, 5.0)
        end
        
        -- Apply physics modifications
        if MOD then
            MidwayPhysics.SetFriction(puck, MOD.engine_mod_friction)
            MidwayPhysics.SetRestitution(puck, MOD.engine_mod_heat)
            MidwayPhysics.SetMass(puck, MOD.engine_mod_mass)
        end
    end)
end

function OnUnload()
    -- Cleanup & diagnostics
    MidwayPhysics.PoolFree("puck_pool")
    print("Strongman attraction unloaded. Puck pool freed.")
end
