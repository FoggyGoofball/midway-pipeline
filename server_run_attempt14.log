function OnLoad()
    -- Shared constants table
    local CONST = {
        mallet_mass = 10,
        mallet_radius = 0.5,
        puck_mass = 5,
        puck_radius = 0.2,
        resting_pos = {0, 0, 0},
        impulse_strength = 200,
        tower_shift = 0.5,
        power_up_delay = 0.5,
    }

    -- State variables (module-level)
    local mallet = nil
    local puck = nil
    local power_up_timer = 0
    local last_streak = 0

    -- Spawn mallet
    mallet = MidwayPhysics.SpawnDynamicSphere(CONST.mallet_radius, CONST.mallet_radius, CONST.mallet_radius, CONST.mallet_mass)
    MidwayPhysics.SetPosition(mallet, CONST.resting_pos[1], CONST.resting_pos[2], CONST.resting_pos[3])
    MidwayPhysics.SetLinearVelocity(mallet, 0, 0, 0)

    -- Spawn puck
    puck = MidwayPhysics.SpawnDynamicSphere(CONST.puck_radius, CONST.puck_radius, CONST.puck_radius, CONST.puck_mass)
    MidwayPhysics.SetPosition(puck, 0, 2, 0)
    MidwayPhysics.SetLinearVelocity(puck, 0, 0, 0)

    -- Register per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Power-up reset logic
        if MidwayInput.IsActionDown("power_up") then
            power_up_timer = power_up_timer + dt
            if power_up_timer >= CONST.power_up_delay then
                power_up_timer = 0
                -- Reset mallet to resting state
                MidwayPhysics.SetLinearVelocity(mallet, 0, 0, 0)
                MidwayPhysics.SetPosition(mallet, CONST.resting_pos[1], CONST.resting_pos[2], CONST.resting_pos[3])

                -- Reset game timer if streak condition met
                if Engine.GetStreak() > 0 then
                    Engine.AwardTokens(1, "reset_bonus")
                    -- Reset streak logic here
                    Engine.SetStreak(0) -- Assuming SetStreak exists; otherwise remove
                end
            end
        end

        -- Task 6: Mallet swing logic
        if MidwayInput.IsActionDown("fire") then
            local pos = MidwayPhysics.GetPosition(mallet)
            local impulse = {CONST.impulse_strength, 0, 0}
            MidwayPhysics.ApplyImpulse(mallet, impulse[1], impulse[2], impulse[3])
        end

        -- Task 7: Tower gauge height shift
        if puck then
            local puck_pos = MidwayPhysics.GetPosition(puck)
            if puck_pos[2] > 2 then
                MidwayPhysics.DestroyBody(puck)
                puck = MidwayPhysics.SpawnDynamicSphere(CONST.puck_radius, CONST.puck_radius, CONST.puck_radius, CONST.puck_mass)
                MidwayPhysics.SetPosition(puck, 0, 2 + CONST.tower_shift, 0)
                MidwayPhysics.SetLinearVelocity(puck, 0, 0, 0)
            end
        end
    end)
end
