function OnLoad()
    -- Spawn lever (static capsule)
    leverHandle = MidwayPhysics.SpawnStaticCapsule(0, 0, 0, 1.0, 0.5)
    
    -- Spawn puck (dynamic sphere)
    puckHandle = MidwayPhysics.SpawnDynamicSphere(0, 0, 1.0, 0.5, 1.0)
    MidwayPhysics.SetFriction(puckHandle, AttractionConstants.modifiers.friction)
    MidwayPhysics.SetRestitution(puckHandle, AttractionConstants.modifiers.restitution)
    
    -- Create puck pool
    MidwayPhysics.CreatePool(puckPoolName, 2, 2, {
        shape = "sphere",
        radius = 0.5,
        mass = 1.0,
        friction = AttractionConstants.modifiers.friction,
        restitution = AttractionConstants.modifiers.restitution
    })
    
    -- Spawn mallet (dynamic capsule)
    malletHandle = MidwayPhysics.SpawnDynamicCapsule(0, 0, 2.0, 1.0, 0.5, 5.0)
    MidwayPhysics.SetFriction(malletHandle, AttractionConstants.modifiers.friction)
    MidwayPhysics.SetRestitution(malletHandle, AttractionConstants.modifiers.restitution)
    
    -- Register per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Wobble platform spawn point
        local wobbleOffset = math.sin(AttractionConstants.modifiers.wobbleFrequency * MidwayPhysics.GetTime()) * AttractionConstants.modifiers.wobbleAmplitude
        
        -- Mallet swing logic
        if MidwayInput.IsActionDown("fire") then
            local swingVelocity = AttractionConstants.modifiers.malletSpeed * powerLevel
            MidwayPhysics.AddLinearVelocity(malletHandle, swingVelocity * math.cos(aimAngle), swingVelocity * math.sin(aimAngle), 0)
        end
        
        -- Scoring logic
        if MidwayInput.IsActionDown("power_up") then
            currentScore = currentScore + 1
            Engine.AwardTickets(1, "score")
            
            -- Award tokens based on streak
            local streak = Engine.GetStreak()
            if streak > 0 then
                Engine.AwardTokens(streak, "streak_bonus")
            end
        end
    end)
end

