function OnLoadStatic()
    -- Spawn permanent cabinet geometry here if needed
end

-- ─── INVARIANT 4: OnLoad → OnStep registration ───
function OnLoad()
    -- Create object pool for pucks
    MidwayPhysics.CreatePool("puck", 2, 2, {
        shape = "sphere",
        mass = PuckMass,
        friction = PuckFriction,
        restitution = PuckRestitution
    })

    -- Spawn the lever (static)
    leverHandle = MidwayPhysics.SpawnStaticCapsule(0, 0, 0, 0.5, 0.5)

    -- Spawn the mallet (dynamic)
    malletHandle = MidwayPhysics.SpawnDynamicCapsule(0, 0, 2, 0.5, 1.0, PuckMass)
    MidwayPhysics.SetLinearVelocity(malletHandle, 0, 0, 0)

    -- Spawn the first puck
    SpawnPuck()

    -- Register the per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Wobble mechanism: apply sinusoidal offset to platform spawn point
        local time = MidwayPhysics.GetTime()
        local wobbleX = math.sin(time * WobbleFrequency) * WobbleAmplitude
        local wobbleZ = math.cos(time * WobbleFrequency) * WobbleAmplitude

        -- Check input for mallet swing
        if MidwayInput.IsActionDown("fire") then
            -- Apply impulse to mallet to simulate swing
            MidwayPhysics.ApplyImpulse(malletHandle, 0, 10 * powerLevel, 0)
        end

        -- Check for puck scoring (simplified logic)
        if MidwayInput.IsActionDown("power_up") then
            currentScore = currentScore + 1
            Engine.AwardTickets(1, "score")
        end
    end)
end

-- ─── INVARIANT 5: OnUnload ──
function OnUnload()
    if malletHandle then
        MidwayPhysics.DestroyBody(malletHandle)
    end
    if puckHandle then
        MidwayPhysics.DestroyBody(puckHandle)
    end
    if leverHandle then
        MidwayPhysics.DestroyBody(leverHandle)
    end
end

-- Helper function to spawn a puck
function SpawnPuck()
    if remainingBalls > 0 then
        local spawnX = wobbleX -- Use current wobble offset
        local spawnY = 0
        local spawnZ = 0
        local puck = MidwayPhysics.PoolAcquire("puck", spawnX, spawnY, spawnZ)
        if puck then
            balls[#balls + 1] = puck
            remainingBalls = remainingBalls - 1
        end
    end
end
