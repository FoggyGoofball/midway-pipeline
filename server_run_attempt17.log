-- ─── INVARIANT 1: Slot identity ────

local handle = nil  -- auto-declared physics handle

-- ─── INVARIANT 2: Constants table (placeholder values) ─
local WOOD_FRICTION = 0.3
local PUCK_FRICTION = 0.1
local PUCK_RESTITUTION = 0.6
local MALLET_RADIUS = 0.5
local PUCK_RADIUS = 0.25
local LEVER_RADIUS = 0.3
local MALLET_SPEED = 15.0
local SWING_PERIOD = 2.0
local WOOD_HEIGHT = 1.0

-- ─── MODULE-LEVEL STATE (shared across all lifecycle functions) ──
local balls = {}
local remainingBalls = 6
local currentScore = 0
local aimAngle = 0.0
local powerLevel = 1.0
local malletHandle = nil
local puckHandle = nil
local leverHandle = nil
local poolName = "strongman_pucks"
local poolHot = 2
local poolCold = 2

-- ─── INVARIANT 3: OnLoadStatic → SpawnSharedBooth ──
function OnLoadStatic()
    -- Spawn shared booth geometry (static)
    -- Placeholder for cabinet/floor geometry
end

-- ─── INVARIANT 4: OnLoad → OnStep registration ───
function OnLoad()
    -- Spawn lever (static)
    leverHandle = MidwayPhysics.SpawnStaticCapsule(0, 0, 0, LEVER_RADIUS, WOOD_HEIGHT)
    MidwayPhysics.SetFriction(leverHandle, WOOD_FRICTION)
    MidwayPhysics.SetRestitution(leverHandle, 0.0)

    -- Create puck pool
    MidwayPhysics.CreatePool(poolName, poolHot, poolCold, {
        radius = PUCK_RADIUS,
        mass = 1.0,
        friction = PUCK_FRICTION,
        restitution = PUCK_RESTITUTION
    })

    -- Spawn mallet (dynamic)
    malletHandle = MidwayPhysics.PoolAcquire(poolName, 0, 0, 0)
    MidwayPhysics.SetFriction(malletHandle, PUCK_FRICTION)
    MidwayPhysics.SetRestitution(malletHandle, PUCK_RESTITUTION)

    -- Spawn first puck
    if remainingBalls > 0 then
        puckHandle = MidwayPhysics.PoolAcquire(poolName, 0, 0, 0)
        MidwayPhysics.SetFriction(puckHandle, PUCK_FRICTION)
        MidwayPhysics.SetRestitution(puckHandle, PUCK_RESTITUTION)
    end

    -- Register per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Mallet swing logic with sinusoidal offset
        local swingPhase = (MidwayPhysics.GetTime() / SWING_PERIOD) * 2 * math.pi
        local swingOffset = math.sin(swingPhase) * 0.5
        local malletPos = MidwayPhysics.GetPosition(malletHandle)
        MidwayPhysics.MoveKinematic(malletHandle, malletPos.x, malletPos.y + swingOffset, malletPos.z)
        
        -- Apply mallet velocity periodically
        if math.abs(swingOffset) > 0.3 then
            local velocity = MALLET_SPEED * math.cos(swingPhase)
            MidwayPhysics.SetLinearVelocity(malletHandle, velocity, 0, 0)
        end

        -- Puck scoring logic
        if MidwayInput.IsActionDown("power_up") then
            currentScore = currentScore + 1
            Engine.AwardTickets(1, "score")
            
            -- Spawn new puck if available
            if remainingBalls > 0 and puckHandle == nil then
                puckHandle = MidwayPhysics.PoolAcquire(poolName, 0, 0, 0)
                MidwayPhysics.SetFriction(puckHandle, PUCK_FRICTION)
                MidwayPhysics.SetRestitution(puckHandle, PUCK_RESTITUTION)
            end
        end

        -- Streak-based token payout
        local streak = Engine.GetStreak()
        if streak > 0 then
            Engine.AwardTokens(streak, "streak_bonus")
        end
    end)
end

-- ─── INVARIANT 5: OnUnload ──
function OnUnload()
    if malletHandle then
        MidwayPhysics.DestroyBody(malletHandle)
    end
    if puckHandle then
        MidwayPhysics.DestroyBody(puckHandle)
    end
    if leverHandle then
        MidwayPhysics.DestroyBody(leverHandle)
    end
    MidwayPhysics.PoolFree(poolName)
end

