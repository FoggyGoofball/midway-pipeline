local LEVER_HEIGHT = 0.1
local LEVER_DEPTH = 0.2
local TOWER_WIDTH = 0.4
local TOWER_HEIGHT = 4.0
local BELL_RADIUS = 0.15
local BELL_OFFSET_Y = 3.5
local WobbleFrequency = 2.0
local WobbleAmplitude = 0.1

-- ─── MODULE-LEVEL STATE ─
local malletHandle = nil
local puckHandle = nil
local leverHandle = nil
local malletAngle = 0.0
local malletSpeed = 0.0
local wobblePhase = 0.0

-- ─── INVARIANT 3: OnLoadStatic ──
function OnLoadStatic()
    -- Spawn static tower and bell
    local towerHandle = MidwayPhysics.SpawnStaticBox(0, 0, 0, TOWER_WIDTH, TOWER_HEIGHT, 1.0)
    local bellHandle = MidwayPhysics.SpawnStaticSphere(0, BELL_OFFSET_Y, 0, BELL_RADIUS)
    -- (Static bodies not required for this task; placeholders for completeness)
end

-- ─── INVARIANT 4: OnLoad ───
function OnLoad()
    -- Spawn lever (static)
    leverHandle = MidwayPhysics.SpawnStaticCapsule(0, 0.05, 0, LEVER_HEIGHT, LEVER_WIDTH)
    -- Spawn puck (dynamic)
    puckHandle = MidwayPhysics.SpawnDynamicSphere(0, 0.2, 0, PUCK_RADIUS, PUCK_MASS)
    MidwayPhysics.SetFriction(puckHandle, 0.3)
    MidwayPhysics.SetRestitution(puckHandle, 0.2)
    -- Spawn mallet (dynamic)
    malletHandle = MidwayPhysics.SpawnDynamicCapsule(0, 0.5, 0, MALLET_HEIGHT, MALLET_RADIUS, 5.0)
    MidwayPhysics.SetFriction(malletHandle, 0.5)
    MidwayPhysics.SetRestitution(malletHandle, 0.1)

    -- Register per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Wobble platform spawn point
        wobblePhase = wobblePhase + WobbleFrequency * dt
        local wobbleX = math.sin(wobblePhase) * WobbleAmplitude
        local wobbleY = math.cos(wobblePhase) * WobbleAmplitude

        -- Mallet swing logic
        malletAngle = malletAngle + malletSpeed * dt
        if malletAngle > math.pi then
            malletAngle = -math.pi
        end
        if malletAngle < -math.pi then
            malletAngle = math.pi
        end

        -- Move mallet to swinging position (using MoveKinematic on dynamic body is not allowed;
        -- instead we respawn mallet at new angle each frame)
        local swingX = math.cos(malletAngle) * 0.5
        local swingY = math.sin(malletAngle) * 0.5
        MidwayPhysics.DestroyBody(malletHandle)
        malletHandle = MidwayPhysics.SpawnDynamicCapsule(swingX, swingY, 0, MALLET_HEIGHT, MALLET_RADIUS, 5.0)
        MidwayPhysics.SetFriction(malletHandle, 0.5)
        MidwayPhysics.SetRestitution(malletHandle, 0.1)

        -- Move puck to wobbled platform position
        MidwayPhysics.DestroyBody(puckHandle)
        puckHandle = MidwayPhysics.SpawnDynamicSphere(wobbleX, wobbleY, 0, PUCK_RADIUS, PUCK_MASS)
        MidwayPhysics.SetFriction(puckHandle, 0.3)
        MidwayPhysics.SetRestitution(puckHandle, 0.2)

        -- Reset lever if needed (static, no movement)
    end)
end

-- ─── INVARIANT 5: OnUnload ──
function OnUnload()
    if malletHandle then MidwayPhysics.DestroyBody(malletHandle) end
    if puckHandle then MidwayPhysics.DestroyBody(puckHandle) end
    if leverHandle then MidwayPhysics.DestroyBody(leverHandle) end
end
