    -- Rogue-like modifiers: apply variable friction, mass, and platform offset
    local MOD = AttractionConstants.modifiers
    local difficulty = 1.0 + MOD.heat * 0.2
    local tilt = MOD.sleight_of_hand
    
    -- Apply variable friction based on heat modifier
    SetFriction(puck, 0.5 * difficulty)
    
    -- Apply platform wobble offset to bell target
    local bell_x, bell_y, bell_z = MidwayPhysics.GetPosition(bell)
    local platform_x, platform_y, platform_z = MidwayPhysics.GetPosition(platform)
    local target_x = platform_x + tilt * 0.1
    local target_y = platform_y + bell_offset
    local target_z = platform_z
    MoveKinematic(bell, target_x, target_y, target_z, dt)
    
