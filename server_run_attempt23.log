    -- [TASK_5_INSERT_HOOK] -- round state init: declare ball counters, timers, and round variables (locals only, no physics)
    local MOD = AttractionConstants.modifiers

    -- Detect fire input to swing the mallet
    if MidwayInput.IsActionDown("fire") then
        -- Apply upward impulse to mallet to swing down
        local swing_force = 50.0 * mallet_integrity
        ApplyImpulse(mallet, 0, swing_force, 0)

        -- Enforce swing cooldown
        if swing_cooldown > 0 then
            return
        end
        swing_cooldown = 0.5

        -- Apply angular impulse to lever for rebound effect
        local spring_tension = 1.0 + (MOD.heat or 0) * 0.2
        ApplyAngularImpulse(spring, 0, 0, spring_tension * 10.0)
    end

    -- Check shock plate hazard
    if IsSensorTriggered(shock_plate) then
        -- Cancel swing and apply damage impulse
        ApplyImpulse(mallet, 0, -20.0, 0)
        swing_cooldown = 2.0
    end

    -- Check bell trigger for win condition
    if IsSensorTriggered(bell) then
        local score = 100 + (MOD.luck or 0) * 10
        Engine.AwardTickets(score, 'WIN')
        Engine.AwardTokens(1, 'BONUS')
        -- Reset puck and bell offset
        MidwayPhysics.DestroyBody(puck)
        puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)
        bell_offset = 0.0
        swing_cooldown = 2.0
    end

    -- Apply sleight_of_hand modifier to bell offset
    local sleight = MOD.sleight_of_hand
    bell_offset = bell_offset + sleight * 0.01

    -- Apply luck modifier to platform wobble
    local luck = MOD.luck
    platform_wobble = platform_wobble + luck * 0.01

    -- Apply nerve modifier to mallet integrity decay
    local nerve = MOD.nerve
    if nerve > 0 then
        mallet_integrity = mallet_integrity - nerve * 0.001
    end

    -- Apply heat modifier to friction on the puck track
    local heat = MOD.heat
    if IsSensorTriggered(rusty_rails) then
        local current_friction = GetFriction(puck)
        local target_friction = 0.5 + heat * 0.5
        SetFriction(puck, target_friction)
    end
