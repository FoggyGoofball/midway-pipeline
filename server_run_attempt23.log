    -- [TASK_5_INSERT_HOOK] -- round state init: declare ball counters, timers, and round variables (locals only, no physics)
    local MOD = AttractionConstants.modifiers
    local bell_shift_range = MOD.sleight_of_hand * 5.0
    
    MidwayPhysics.OnStep(function(dt)
        -- Read modifiers each frame (no caching)
        local friction = MOD.friction
        local tension = MOD.tension
        
        -- Apply swing impulse to mallet if fire is pressed
        if MidwayInput.IsActionDown("fire") then
            ApplyImpulse(mallet, 0, -tension, 0)
            
            -- Launch puck if lever is triggered
            if IsSensorTriggered(levers) then
                ApplyImpulse(puck, 0, tension * mallet_integrity, 0)
            end
        end
        
        -- Apply variable friction from rusty rails sensor
        if IsSensorTriggered(rusty_rails) then
            SetLinearDamping(puck, friction)
        end
        
        -- Bell's Curse: randomly shift bell height
        bell_offset = bell_offset + (math.random(-1, 1) * bell_shift_range)
        MoveKinematic(bell, 0, bell_offset, 0, dt)
        
        -- Check bell collision
        if IsSensorTriggered(bell) then
            -- Award tickets based on streak
            local streak = Engine.GetStreak()
            Engine.AwardTickets(streak, 'WIN')
            
            -- Destroy old puck and respawn fresh one
            DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)
            
            -- Reset bell offset slightly to prevent runaway
            bell_offset = bell_offset * 0.9
        end
    end)
