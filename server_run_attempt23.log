    -- Bell collision and "The Bell's Curse": shift bell height, destroy/respawn puck
    local bell_x, bell_y, bell_z = MidwayPhysics.GetPosition(bell)
    local puck_x, puck_y, puck_z = MidwayPhysics.GetPosition(puck)
    
    if puck_y >= bell_y then
        -- Bell hit!
        streak_wager = streak_wager + 1
        -- Destroy old puck and respawn at new height
        MidwayPhysics.DestroyBody(puck)
        puck = MidwayPhysics.PoolAcquire(puck_pool, 0, bell_y + 2, 0)
        -- Reset bell to random height
        bell_y = bell_y + (math.random(-0.5, 0.5) * 0.5)
        MoveKinematic(bell, bell_x, bell_y, bell_z, dt)
    end
    
