function OnLoad()
    -- Spawn platform (kinematic)
    platformHandle = MidwayPhysics.SpawnKinematicBox(0, 0, 0, 2, 1, 1)
    
    -- Spawn mallet (dynamic)
    malletHandle = MidwayPhysics.SpawnDynamicBox(0, 5, 0, 0.5, 0.5, 0.5, 10)
    
    -- Register per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Wobble logic
        wobbleOffset = wobbleOffset + 0.01
        local x = math.sin(wobbleOffset) * 0.1
        MidwayPhysics.MoveKinematic(platformHandle, x, 0, 0, dt)
        
        -- Mallet hit logic
        if MidwayPhysics.IsActionDown("fire") then
            hitCount = hitCount + 1
            if hitCount >= 3 then
                MidwayPhysics.SetMass(malletHandle, 5)
                hitCount = 0
            end
        end
    end)
end

function OnUnload()
    if platformHandle then
        MidwayPhysics.DestroyBody(platformHandle)
    end
    if malletHandle then
        MidwayPhysics.DestroyBody(malletHandle)
    end
end
