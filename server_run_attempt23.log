function OnStep(dt)
    local MOD = AttractionConstants.modifiers

    -- Task 5: Swing mechanic
    if MidwayInput.IsActionDown("fire") and swing_cooldown <= 0 then
        MidwayPhysics.MoveKinematic(swing_handle, 0, 1.5, 0, dt)
        swing_cooldown = MOD.swing_cooldown
    else
        swing_cooldown = math.max(0, swing_cooldown - dt)
    end

    -- Task 8: Cracked base wobble
    local wobble = math.sin(os.time() * 2) * 0.05
    MidwayPhysics.MoveKinematic(base_handle, wobble, 0, 0, dt)

    -- Shock Plate Timer Logic
    if IsSensorTriggered(shock_plate) then
        shock_plate_timer = shock_plate_timer + dt
        if shock_plate_timer > PENALTY_DELAY then
            Engine.AwardTokens(-PENALTY_AMOUNT, "shock_plate")
            shock_plate_timer = 0
        end
    else
        shock_plate_timer = 0
    end
end
