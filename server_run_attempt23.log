    -- Swing mechanics: apply impulse to mallet, handle puck launch
    local MOD = AttractionConstants.modifiers
    local power = 1.0 + MOD.nerve * 0.5
    
    if MidwayInput.IsActionDown("fire") then
        -- Apply impulse to swing mallet down
        local impulse = power * 50
        ApplyImpulse(mallet, 0, impulse, 0)
        
        -- Check if mallet hit lever to launch puck
        local mallet_x, mallet_y, mallet_z = MidwayPhysics.GetPosition(mallet)
        local lever_y = -2.0 -- Simplified lever height check
        if mallet_y <= lever_y then
            -- Launch puck
            MidwayPhysics.DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)
            ApplyImpulse(puck, 0, power * 30, 0)
        end
    end
    
