            local now = MidwayPhysics:GetTime()
            if now - lastBellRingTime > bellCooldown then
                bellTriggered = true
                local ticketsToAward = math.floor(MOD.bell_tickets * streakMultiplier)
                Engine.AwardTickets(ticketsToAward, "Bell Ring")
                lastBellRingTime = now
                bellSensor:SetSensorTriggered(false)
            end
        end
        bellSensor = nil
