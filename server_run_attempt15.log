  local function ApplyTowerGaugeShift(dt)  -- task win Helper to handle gauge shift respawn
    local MOD = AttractionConstants.modifiers
    local shift_chance = MOD.luck or 0.0
    if tower_gauge_shift_active and shift_chance > 0.0 then
      local lx, ly, lz = MidwayPhysics.GetPosition(puck)
      MidwayPhysics.DestroyBody(puck)
      MidwayPhysics.PoolReturn(puck_pool, puck)
      local new_height = ly + (math.random(-2.0, 2.0) * shift_chance)
      MidwayPhysics.SpawnDynamicSphere(lx, new_height, lz, 0.5, 1.0)
      tower_gauge_shift_active = false
    end
  end
