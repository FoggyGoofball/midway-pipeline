local puck = nil
local shockPlate = nil
local towerGauge = nil

local function ApplyRustyRails(dt)
  local MOD = AttractionConstants.modifiers
  local friction = 0.5 + (MOD.heat or 0.0) * 0.5
  MidwayPhysics.SetFriction(puck, friction)
end

local function ApplyShockPlates(dt)
  if shockPlate and MidwayPhysics.IsSensorTriggered(shockPlate) then
    local MOD = AttractionConstants.modifiers
    local impulse = (MOD.nerve or 0.0) * 100.0
    MidwayPhysics.ApplyImpulse(shockPlate, 0, impulse, 0)
  end
end

local function ApplyTowerGaugeShift(dt)
  local MOD = AttractionConstants.modifiers
  local shift = (MOD.luck or 0.0) * 5.0
  if towerGauge then
    local pos = MidwayPhysics.GetPosition(towerGauge)
    MidwayPhysics.MoveKinematic(towerGauge, pos.x, pos.y, pos.z + shift, dt)
  end
end

function OnLoadStatic()
  shockPlate = MidwayPhysics.SpawnStaticBox(0, 0, 0, 2, 1, 1)
  towerGauge = MidwayPhysics.SpawnStaticSphere(0, 5, 0, 1)
end

function OnLoad()
  puck = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, 1, 1)
  MidwayPhysics.OnStep(function(dt)
    ApplyRustyRails(dt)
    ApplyShockPlates(dt)
    ApplyTowerGaugeShift(dt)
  end)
end

function OnUnload()
  if puck then MidwayPhysics.DestroyBody(puck) end
  if shockPlate then MidwayPhysics.DestroyBody(shockPlate) end
  if towerGauge then MidwayPhysics.DestroyBody(towerGauge) end
end
