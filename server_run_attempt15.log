    -- [TASK_6_INSERT_HOOK] -- input handling / aiming mechanism setup
    local aim_delta = {x = 0.0, y = 0.0, z = 0.0}
    local power_scale = 1.0
    local last_hit_spot = nil
    local hit_count = 0
    local hit_timer = 0.0
    local echo_window = 0.5

    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers

        -- Input Aiming & Swing Trigger
        if MidwayInput.IsActionDown("aim_left") then
            aim_delta.x = -1.0
        elseif MidwayInput.IsActionDown("aim_right") then
            aim_delta.x = 1.0
        else
            aim_delta.x = 0.0
        end

        if MidwayInput.IsActionDown("fire") then
            -- Apply swing impulse to mallet
            local swing_power = power_scale * mallet_integrity
            ApplyImpulse(mallet, aim_delta.x * swing_power, 0.0, 0.0)

            -- Check lever trigger
            if IsSensorTriggered(lever) then
                -- Launch puck
                local launch_force = 10.0 * swing_power
                ApplyImpulse(puck, 0.0, launch_force, 0.0)

                -- Echo Strikes mechanic
                if last_hit_spot then
                    local dist = math.abs(last_hit_spot - hit_count)
                    if dist < echo_window then
                        hit_count = hit_count + 1
                        echo_streak = echo_streak + 1
                        -- Increase tension (visual/audio feedback could go here)
                    else
                        hit_count = 0
                        echo_streak = 0
                    end
                else
                    last_hit_spot = hit_count
                    echo_streak = 1
                end
            else
                -- Reset echo on miss
                hit_count = 0
                echo_streak = 0
            end
        end

        -- Rusty Rails friction
        if IsSensorTriggered(rusty_rails) then
            local friction_mod = RUSTY_FRICTION * (1.0 - MOD.heat * 0.5)
            SetLinearDamping(puck, friction_mod)
        end

        -- Shock Plates hazard
        if IsSensorTriggered(shock_plates) then
            if swing_cooldown > 0.5 then
                Engine.AwardTokens(-1, 'Soul Tokens')
                ApplyImpulse(mallet, -aim_delta.x * 5.0, 0.0, 0.0)
            end
        end

        -- Tower Gauge Shift respawn
        if tower_gauge_shift_active then
            local lx, ly, lz = MidwayPhysics.GetPosition(puck)
            local new_height = ly + (math.random() * 5.0 - 2.5)
            MidwayPhysics.DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, lx, new_height, lz)
            tower_gauge_shift_active = false
        end

        -- Update cooldowns
        swing_cooldown = math.max(0.0, swing_cooldown - dt)
        hit_timer = math.max(0.0, hit_timer - dt)
    end)
