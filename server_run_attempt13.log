function OnLoadStatic()
    SpawnSharedBooth()
end

local balls = {}
local mallets = {}

function OnLoad()
    MidwayPhysics.CreatePool("puck_pool", 3, 1, {})
    MidwayPhysics.CreatePool("mallet_pool", 1, 1, {})

    MidwayPhysics.OnStep(function(dt)
        local modifiers = AttractionConstants.modifiers
        -- Apply modifiers every frame, not cached at load time
        for _, ball in ipairs(balls) do
            if MidwayPhysics.IsActive(ball) then
                MidwayPhysics.SetFriction(ball, 0.5 * modifiers.engine_mod_friction)
                MidwayPhysics.SetMass(ball, 1.0 * modifiers.engine_mod_mass)
            end
        end
        for _, mallet in ipairs(mallets) do
            if MidwayPhysics.IsActive(mallet) then
                MidwayPhysics.SetFriction(mallet, 0.8 * modifiers.engine_mod_friction)
            end
        end
    end)
end

function OnUnload()
    for _, ball in ipairs(balls) do
        MidwayPhysics.DestroyBody(ball)
    end
    for _, mallet in ipairs(mallets) do
        MidwayPhysics.DestroyBody(mallet)
    end
    MidwayPhysics.PoolFree("puck_pool")
    MidwayPhysics.PoolFree("mallet_pool")
end
