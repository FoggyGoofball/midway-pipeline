    -- Register the single per-frame callback
    MidwayPhysics.OnStep(function(dt)
        -- Read modifiers every frame
        local MOD = AttractionConstants.modifiers
        
        -- Check input using approved API
        if MidwayInput.IsActionDown("fire") then
            -- Apply impulse to ball
            MidwayPhysics.ApplyImpulse(balls[1], 0, 0, 10 * MOD.engine_mod_nerve)
        end
        
        -- Update physics properties
        MidwayPhysics.SetFriction(balls[1], 0.5 * MOD.engine_mod_friction)
        MidwayPhysics.SetMass(balls[1], 1.0 * MOD.engine_mod_mass)
    end)
end

-- ─── INVARIANT 5: OnUnload → Cleanup ──────
function OnUnload()
    for _, handle in ipairs(balls) do
        MidwayPhysics.DestroyBody(handle)
    end
    balls = {}
end
