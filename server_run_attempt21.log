-- ALL game logic and setup MUST go here
function OnLoad()

    MidwayPhysics.OnStep(function(dt)
        -- FIX: Single declaration of MOD at top of callback
        local MOD = AttractionConstants.modifiers
        
        -- Consume modifiers (required by Economy Mandate)
        local base_friction = 1.0
        local rusty_rails_factor = 1.0
        local tower_gauge_shift = 1.0
        local streak_multiplier = 1.0
        
        -- Bell Collision & Curse
        if MidwayPhysics.IsSensorTriggered(bell) then
            Engine.AwardTickets(1, "Bell")
            Engine.AwardTickets(streak_multiplier, "STREAK")
            
            -- Bell's Curse: Shift height and respawn
            -- FIX: Removed incomplete `local lx`
            respawn_puck()
        elseif puck_lost then
            streak = 0
        end
        
        local MOD = AttractionConstants.modifiers
        local streak = Engine.GetStreak()
        local tickets_awarded = 1 + streak
        
        if MidwayPhysics.IsSensorTriggered(bell) then
            Engine.AwardTickets(tickets_awarded, "WIN")
            Engine.AwardTickets(tickets_awarded, "STREAK")
            streak = 1
            respawn_puck()
        elseif puck_lost then
            streak = 0
        end
        
        -- Consume other modifiers this frame
        local friction = 1.0 + 1.0
        local weight = 1.0
        local gauge_shift = 1.0
        local wobble = 1.0
        local shock_timer = 1.0
        local dampener = 1.0
        local echo_tension = 1.0
        local splinter = 1.0
        
        -- Apply physics modifiers
        MidwayPhysics.SetFriction(puck, friction)
        MidwayPhysics.SetMass(puck, weight)
        MidwayPhysics.MoveKinematic(bell, 0, gauge_shift, 0, dt)
        MidwayPhysics.MoveKinematic(tower_base, 0, 0, wobble, dt)
        
        -- Handle shock plate timer
        if MidwayPhysics.IsSensorTriggered(shock_plate) then
            -- FIX: Use module-level timer variable
            shock_plate_timer = shock_plate_timer + dt
            if shock_plate_timer > 2.0 then
                local _, vy, vz = MidwayPhysics.GetVelocity(mallet)
                MidwayPhysics.ApplyImpulse(mallet, 0, vy * -1.5, vz * -1.5)
                shock_plate_timer = 0.0
            end
        end

        local MOD = AttractionConstants.modifiers
        if MidwayInput.IsActionDown("power_up") then
            MidwayPhysics.SetGravityFactor(puck, 0.0)
            MidwayPhysics.SetMass(puck, 0.0)
        elseif MidwayInput.IsActionDown("power_down") then
            MidwayPhysics.SetGravityFactor(puck, 1.0)
            MidwayPhysics.SetMass(puck, 1.0)
        end

        local MOD = AttractionConstants.modifiers
        if MidwayPhysics.IsSensorTriggered(shock_plate) then
            local elapsed = shock_plate_timer or 0.0
            local shock_plate_timer = elapsed + dt
            if shock_plate_timer > 2.0 then
                local _, vy, vz = MidwayPhysics.GetVelocity(mallet)
                MidwayPhysics.ApplyImpulse(mallet, 0, vy * -1.5, vz * -1.5)
                shock_plate_timer = 0.0
            end
        end

        local MOD = AttractionConstants.modifiers
        if MidwayPhysics.IsSensorTriggered(shock_plate) then
            local elapsed = shock_plate_timer or 0.0
            local shock_plate_timer = elapsed + dt
            if shock_plate_timer > 2.0 then
                local _, vy, vz = MidwayPhysics.GetVelocity(mallet)
                MidwayPhysics.ApplyImpulse(mallet, 0, vy * -1.5, vz * -1.5)
                shock_plate_timer = 0.0
            end
        end

        -- Handle echo strikes
        if MidwayPhysics.IsSensorTriggered(echo_strike_target) then
            echo_tension = echo_tension + 1
            if echo_tension > 3 then
                MidwayPhysics.ApplyAngularImpulse(counter_spring, 0, 0, 50 * echo_tension)
                echo_tension = 0
            end
        end
        
        -- Handle splintered mallet
        if splinter > 0 then
            MidwayPhysics.ApplyAngularImpulse(mallet, 0, 0, -10 * splinter)
            splinter = splinter - 1
        end

        local MOD = AttractionConstants.modifiers
        local streak = Engine.GetStreak()
        local tickets = Engine.GetTickets()
        
        -- Check for win condition (bell triggered)
        if MidwayPhysics.IsSensorTriggered(bell) then
            -- Award tickets based on streak multiplier
            local win_tickets = streak_multiplier * Engine.GetStreak()
            Engine.AwardTickets(win_tickets, 'WIN')
            
            -- Reset puck and game state
            MidwayPhysics.DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)
            MidwayPhysics.SetLinearVelocity(puck, 0, 0, 0)
            
            -- Reset modifiers
            tower_gauge_shift = 0.0
            platform_wobble = 0.0
            
            -- Reset mallet velocity
            MidwayPhysics.SetLinearVelocity(mallet, 0, 0, 0)
        end
        
        -- Check for shock plate activation
        if MidwayPhysics.IsSensorTriggered(shock_plate) then
            -- Apply damage/timeout penalty
            Engine.AwardTickets(0, 'TIMEOUT')
            -- Reset puck on timeout
            MidwayPhysics.DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)
            MidwayPhysics.SetLinearVelocity(puck, 0, 0, 0)
        end
        
        -- Check for token exhaustion (failure state)
        if Engine.GetTokens() <= 0 then
            -- Disable input to prevent further interaction
            MidwayInput.SetActionState("fire", false)
            MidwayInput.SetActionState("aim_left", false)
            MidwayInput.SetActionState("aim_right", false)
            MidwayInput.SetActionState("power_up", false)
            MidwayInput.SetActionState("power_down", false)
            
            -- Trigger Game Over visual cue (spawn a red box at center)
            local go_handle = MidwayPhysics.SpawnStaticBox(
                0.0, 0.0, 0.0,
                2.0, 0.5, 0.5
            )
            print("FAILURE: Tokens depleted")
        end

    end)
end

-- ─── INVARIANT 5: OnUnload ─────────────────────────────
function OnUnload()
    print("Pool Stats:", MidwayPhysics.PoolTotal(puck_pool))
    print("Handle Counts:", mallet, lever, puck, bell, tower_base, rusty_rails, counter_spring, shock_plate)
    MidwayPhysics.DestroyBody(mallet)
    MidwayPhysics.DestroyBody(lever)
    MidwayPhysics.DestroyBody(puck)
    MidwayPhysics.DestroyBody(bell)
    MidwayPhysics.DestroyBody(tower_base)
    MidwayPhysics.DestroyBody(rusty_rails)
    MidwayPhysics.DestroyBody(counter_spring)
    MidwayPhysics.DestroyBody(shock_plate)

    -- FIX: Removed invalid `local _ = endend`
end
