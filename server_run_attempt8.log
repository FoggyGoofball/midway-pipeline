local spring_tension = 1.0
local bell_height_offset = 0.0
local mallet_integrity = 1.0
local puck_pool = "puck_pool"

function OnLoadStatic()
    MidwayPhysics.SpawnStaticBox(0, 0, 0, 2, 2, 2)
end

function OnLoad()
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local is_firing = MidwayInput.IsActionDown("fire")
        if is_firing then
            MidwayInput.IsActionDown("power_up")
            local p = MidwayPhysics.GetPosition(1)
            MidwayPhysics.SetLinearVelocity(1, 0, 0, 1)
        end
        spring_tension = spring_tension + MOD.engine_mod_heat * dt
        bell_height_offset = bell_height_offset + MOD.engine_mod_karma * dt
        mallet_integrity = mallet_integrity + MOD.engine_mod_luck * dt
    end)
end

function OnUnload()
    MidwayPhysics.DestroyBody(1)
end
