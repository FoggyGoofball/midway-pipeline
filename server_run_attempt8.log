    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local streak = Engine.GetStreak()

        if IsSensorTriggered(bell_sensor) then
            local base_reward = 100
            local reward = base_reward + streak
            Engine.AwardTickets(reward, 'BellWin')
            bell_sensor = nil
        end

        local tilt = MOD.sleight_of_hand
        bell_height_offset = bell_height_offset + tilt * 0.1

        local difficulty = 1.0 + MOD.heat * 0.2
        if puck ~= nil then
            local lx, ly, lz = MidwayPhysics.GetPosition(puck)
            local vx, vy, vz = MidwayPhysics.GetVelocity(puck)
            if vy < 0 then
                MidwayPhysics.DestroyBody(puck)
                puck = nil
            end
            MidwayPhysics.SetFriction(rail_friction, difficulty)
        end
    end)
