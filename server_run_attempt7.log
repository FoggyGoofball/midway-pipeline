local PUCK_RADIUS = 0.15
local PUCK_MASS_DEFAULT = 0.5
local MALLET_RADIUS = 0.25
local MALLET_MASS_DEFAULT = 15.0
local PUCK_Y_VELOCITY_TARGET = 4.0
local BASE_PLATFORM_Y = 0.0
local TOWER_START_Y = 0.2
local TOWER_TOP_Y = 4.0
local LEVER_Y_OFFSET = -0.3
local FRICTION_RUSTY = 0.85
local FRICTION_STEEL = 0.45
local SENSOR_BELL_Y = 4.5
local SENSOR_BASE_Y = -0.2

local balls = {}
local mallet = nil

function OnLoadStatic()
end

function OnLoad()
    -- Spawn Mallet
    mallet = MidwayPhysics.SpawnDynamicBox(0.0, 0.0, 0.0, 0.1, 0.8, 0.2, MALLET_MASS_DEFAULT)
    MidwayPhysics.SetFriction(mallet, FRICTION_STEEL)
    
    -- Spawn Puck
    local puck = MidwayPhysics.SpawnDynamicSphere(0.0, 0.0, TOWER_TOP_Y, PUCK_RADIUS, PUCK_MASS_DEFAULT)
    MidwayPhysics.SetFriction(puck, FRICTION_STEEL)
    
    balls[puck] = true
    
    -- Spawn Bell Sensor
    local bellSensor = MidwayPhysics.SpawnSensorSphere(0.0, SENSOR_BELL_Y, 0.0, 0.2)
    
    MidwayPhysics.OnStep(function(dt)
        if not mallet then return end
        
        -- Simple mallet drop logic (could be improved with physics impulse later)
        local pos = MidwayPhysics.GetPosition(mallet)
        if pos[3] < BASE_PLATFORM_Y then
            -- Hit bottom
            MidwayPhysics.SetLinearVelocity(mallet, 0, 0, 0)
        else
            -- Apply gravity/drop
            MidwayPhysics.SetLinearVelocity(mallet, 0, PUCK_Y_VELOCITY_TARGET, 0)
        end
        
        -- Check collisions with puck manually via position diff or sensor logic
        -- For this demo, just ensure puck falls if not held (simplified)
        
        local puckPos = MidwayPhysics.GetPosition(puck)
        if puckPos[3] < SENSOR_BELL_Y then
            -- Simple bell ring trigger (requires sensor check in robust code, omitted for syntax fix focus)
        end
    end)
end

function OnUnload()
    if mallet then
        MidwayPhysics.DestroyBody(mallet)
    end
    for h in pairs(balls) do
        MidwayPhysics.DestroyBody(h)
    end
end
