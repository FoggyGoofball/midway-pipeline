    -- [TASK_9_INSERT_HOOK] -- dynamic difficulty tuning: recompute heat/luck/sleight-of-hand from current streak on score events
    -- Helper function to construct compound lever body from static and kinematic parts
    local function construct_compound_lever_body(static_parts, kinematic_parts)
        local lever_body = {}
        local total_leverage = 0
        local current_position = 0

        -- Process static parts (base, fulcrum, fixed supports)
        for _, part in ipairs(static_parts) do
            table.insert(lever_body, part)
            -- Static parts define the base geometry and initial leverage points
            if part.type == "fulcrum" then
                current_position = part.position
            end
        end

        -- Process kinematic parts (movable arms, weights, connectors)
        for _, part in ipairs(kinematic_parts) do
            local relative_leverage = part.leverage_ratio or 1.0
            total_leverage = total_leverage + (relative_leverage * current_position)
            table.insert(lever_body, part)

            -- Update current position based on kinematic movement
            if part.type == "movable_arm" then
                current_position = current_position + part.offset
            end
        end

        -- Calculate final compound leverage factor
        local final_leverage = total_leverage / (current_position + 1)
        lever_body.final_leverage = final_leverage
        lever_body.total_parts = #lever_body

        return lever_body
    end

