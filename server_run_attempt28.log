local platform_wobble_offset = 0.0  -- task 1 Current horizontal offset of the platform due to cracked base.
local mallet_health = 1.0  -- task 1 Remaining integrity of the mallet head (1.0 = new, 0.0 = splintered).
local puck_count = 0  -- task 1 Count of active pucks currently in the air (for cleanup logic).
local swing_phase = 0.0  -- task 1 Current swing phase of the mallet (0.0 = up, 1.0 = down).
local puck_height = 0.0  -- task 1 Current vertical height of the puck.
local streak_wager = 0  -- task 1 Current wagered tickets from the streak protocol.
local mallet_handle = nil
local puck_handle = nil

function OnLoadStatic()
    -- Spawn static platform geometry here if needed
end

function OnLoad()
    -- Spawn dynamic mallet
    mallet_handle = MidwayPhysics.SpawnDynamicBox(0, 0, 2, 1, 1, 1, 10)
    MidwayPhysics.OnStep(function(dt)
        -- Per-frame logic for mallet swing
        swing_phase = swing_phase + dt * 2
        if swing_phase > 1.0 then
            swing_phase = 0.0
        end
        
        -- Apply velocity based on swing phase
        local targetY = (1.0 - swing_phase) * 2.0
        local currentY = MidwayPhysics.GetPosition(mallet_handle)[3]
        MidwayPhysics.SetLinearVelocity(mallet_handle, 0, (targetY - currentY) / dt, 0)
        
        -- Handle puck interaction
        if puck_handle and MidwayPhysics.IsActive(puck_handle) then
            local puckPos = MidwayPhysics.GetPosition(puck_handle)
            local malletPos = MidwayPhysics.GetPosition(mallet_handle)
            
            -- Simple collision check
            if math.abs(puckPos[3] - malletPos[3]) < 0.5 and math.abs(puckPos[1] - malletPos[1]) < 0.5 then
                MidwayPhysics.ApplyImpulse(puck_handle, 0, 5, 0)
                puck_count = puck_count + 1
            end
        end
    end)
end

function OnUnload()
    if mallet_handle then
        MidwayPhysics.DestroyBody(mallet_handle)
    end
end
