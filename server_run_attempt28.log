function OnLoad()
    local Constants = {
        BallRadius = 0.5,
        BallColor = Color.new(0.9, 0.2, 0.2),
        Gravity = Vector.new(0, -9.81, 0),
        Friction = 0.8,
        Bounciness = 0.7,
        BaseWager = 100,
        MaxStreakMultiplier = 5.0,
        StreakResetThreshold = 3
    }

    -- Module-level state required for OnStep callback access
    local bell_sensor = MidwayPhysics.SpawnSensorBox(0, 0, 0, 1, 1, 1)
    local bell = MidwayPhysics.SpawnKinematicBox(0, 5, 0, 1, 2, 1)
    local puck = nil

    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers or {}

        -- Check bell sensor trigger
        if MidwayPhysics.IsSensorTriggered(bell_sensor) then
            local streak = Engine.GetStreak()
            local tickets = streak * Engine.GetTickets()
            Engine.AwardTickets(tickets, 'BELL_HIT')

            -- Handle Bell's Curse: shift bell height if cursed
            if MOD.bell_curse then
                local curse_offset = 1.0 * 0.5
                MidwayPhysics.MoveKinematic(bell, bell:GetPositionX(), bell:GetPositionY() + curse_offset, bell:GetPositionZ(), dt)
            end

            -- Destroy old puck and respawn at new height
            if puck and MidwayPhysics.IsActive(puck) then
                MidwayPhysics.DestroyBody(puck)
            end
            puck = MidwayPhysics.PoolAcquire('puck_pool', bell:GetPositionX(), bell:GetPositionY() + Constants.BallRadius, bell:GetPositionZ())
        end

        -- Consume modifiers for gameplay tuning
        local friction = 0.5 + (MOD.heat or 0) * 0.1
        if puck and MidwayPhysics.IsActive(puck) then
            MidwayPhysics.SetLinearVelocity(puck, 0, 0, 0)
        end
    end)
end
