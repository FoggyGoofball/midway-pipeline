function OnLoadStatic()
    -- Permanent geometry (cabinet, floor)
    local h = MidwayPhysics.SpawnStaticBox(0, 0, 0, 10, 5, 10)
end

function OnLoad()
    local mallet_handle = MidwayPhysics.SpawnDynamicBox(0, 1, 0, 1, 1, 1, 5)
    local puck_handle = MidwayPhysics.SpawnDynamicSphere(0, 1.5, 0, 0.2, 0.5)
    local bell_handle = MidwayPhysics.SpawnDynamicCapsule(0, 2, 0, 0.5, 0.3)
    local platform_handle = MidwayPhysics.SpawnDynamicBox(0, 0.5, 0, 4, 0.1, 8)
    local sensor_rails_handle = MidwayPhysics.SpawnSensorBox(0, 1.2, 0, 2, 0.05, 10)
    local sensor_shock_handle = MidwayPhysics.SpawnSensorSphere(0, 1.8, 0, 0.3)

    local MOD = AttractionConstants.modifiers
    local friction = MOD.friction or 0.5
    local mass = MOD.mass or 1.0

    -- ApplyImpulse requires 4 args: handle, ix, iy, iz, dt
    -- Example usage (if needed): MidwayPhysics.ApplyImpulse(handle, 0, 0, 10, dt)

    MidwayPhysics.OnStep(function(dt)
        -- Read modifiers every frame
        local mods = AttractionConstants.modifiers
        local f = mods.friction or 0.5
        local m = mods.mass or 1.0

        -- Input handling for lever
        if MidwayInput.IsActionDown("fire") then
            -- Apply angular impulse to lever
            MidwayPhysics.ApplyAngularImpulse(mallet_handle, 0, 0, 1, dt)
        end

        -- Launch puck logic
        if puck_handle and MidwayPhysics.IsSensorTriggered(sensor_shock_handle) then
            MidwayPhysics.SetLinearVelocity(puck_handle, 0, 5, 0)
        end
    end)
end

function OnUnload()
    if mallet_handle then
        local lx, ly, lz = MidwayPhysics.GetPosition(mallet_handle)
        print("Mallet:", lx, ly, lz)
    end
    if puck_handle then
        local lx, ly, lz = MidwayPhysics.GetPosition(puck_handle)
        print("Puck:", lx, ly, lz)
    end
    if bell_handle then
        local lx, ly, lz = MidwayPhysics.GetPosition(bell_handle)
        print("Bell:", lx, ly, lz)
    end
    if platform_handle then
        local lx, ly, lz = MidwayPhysics.GetPosition(platform_handle)
        print("Platform:", lx, ly, lz)
    end
    if sensor_rails_handle then
        local lx, ly, lz = MidwayPhysics.GetPosition(sensor_rails_handle)
        print("Rails:", lx, ly, lz)
    end
    if sensor_shock_handle then
        local lx, ly, lz = MidwayPhysics.GetPosition(sensor_shock_handle)
        print("Shock:", lx, ly, lz)
    end
    print("Puck Pool Total:", MidwayPhysics.PoolTotal('puck_pool'))
end
