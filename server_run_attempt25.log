    -- [TASK_6_INSERT_HOOK] -- input handling / aiming mechanism setup
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local lx, ly, lz = MidwayPhysics.GetPosition(puck_handle)
        local bell_lx, bell_ly, bell_lz = MidwayPhysics.GetPosition(bell_handle)
        
        -- Rusty Rails: Apply friction if puck is in contact with rails
        if IsSensorTriggered(sensor_rails_handle) then
            MidwayPhysics.SetLinearDamping(puck_handle, 0.8)
        end
        
        -- Tower Gauge Shift: Randomly respawn puck at new height if timer triggers
        if bell_shift_timer > 0 and bell_shift_timer <= dt then
            MidwayPhysics.DestroyBody(puck_handle)
            local new_height = bell_ly + (MOD.luck * 0.5 - 0.2)
            puck_handle = MidwayPhysics.PoolAcquire('puck_pool', bell_lx, new_height, bell_lz)
            bell_shift_timer = 0
        end
        
        -- Check win condition: Puck reaches bell height
        if ly >= bell_ly then
            -- Award Tickets based on streak multiplier
            local tickets = Engine.GetStreak() * 10
            Engine.AwardTickets(tickets, 'Bell Strike')
            
            -- Reset puck for next attempt
            MidwayPhysics.DestroyBody(puck_handle)
            puck_handle = MidwayPhysics.PoolAcquire('puck_pool', bell_lx, bell_ly - 1, bell_lz)
