function OnLoad()
    local lx, ly, lz = 0, 0, 0
    local mallet = MidwayPhysics.SpawnDynamicCapsule(lx, ly, lz, 0.5, 1.0, 1.0)
    local puck = MidwayPhysics.SpawnDynamicSphere(lx, ly, lz, 0.2)
    local bell = MidwayPhysics.SpawnDynamicSphere(lx, ly, lz, 0.3)
    local platform = MidwayPhysics.SpawnStaticBox(lx, ly, lz, 2.0, 0.1, 4.0)
    local rails = MidwayPhysics.SpawnSensorBox(lx, ly, lz, 0.1, 0.1, 2.0)
    local shock = MidwayPhysics.SpawnSensorBox(lx, ly, lz, 0.1, 0.1, 1.0)
    
    mallet_handle = mallet
    puck_handle = puck
    bell_handle = bell
    platform_handle = platform
    sensor_rails_handle = rails
    sensor_shock_handle = shock
    
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local friction = MOD.friction or 0.5
        local mass = MOD.mass or 1.0
        
        if swing_cooldown > 0 then
            swing_cooldown = swing_cooldown - dt
        end
        
        if bell_shift_timer > 0 then
            bell_shift_timer = bell_shift_timer - dt
        end
        
        if mallet_integrity < 0.0 then
            MidwayPhysics.DestroyBody(mallet_handle)
            mallet_handle = nil
        end
        
        if puck_height_offset ~= 0.0 then
            -- Placeholder for height offset logic
        end
        
        if echo_hit_count > 0 then
            -- Placeholder for echo hit logic
        end
    end)
end

