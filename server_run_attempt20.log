    -- Spawn gameplay bodies
    mallet = MidwayPhysics.SpawnDynamicCapsule(0, 0, 0, mallet_half_height, mallet_radius, puck_mass)
    lever = MidwayPhysics.SpawnDynamicBox(0, 0, 0, lever_w, lever_h, lever_d, puck_mass)
    puck = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, puck_radius, puck_mass)
    bell = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, bell_radius, puck_mass)
    platform = MidwayPhysics.SpawnDynamicBox(0, 0, 0, platform_w, platform_h, platform_d, puck_mass)
    rail = MidwayPhysics.SpawnDynamicCylinder(0, 0, 0, rail_radius, rail_height, puck_mass)
    spring = MidwayPhysics.SpawnDynamicCapsule(0, 0, 0, spring_half_height, rail_radius, puck_mass)
    puck_pool = MidwayPhysics.PoolAcquire(puck_pool_pool, 0, 0, 0)
    
