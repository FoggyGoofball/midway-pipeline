    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        
        -- Apply swing impulse to mallet on fire input
        if MidwayInput.IsActionDown("fire") then
            local impulse = 0.5 * MOD.swing_force
            MidwayPhysics.ApplyImpulse(mallet, 0, impulse, 0)
        end
        
        -- Tower Gauge Shift: Randomly respawn puck at new height if triggered
        if MidwayPhysics.IsSensorTriggered(puck) then
            MidwayPhysics.DestroyBody(puck)
            local random_y = math.random(-5, 5)
            local lx, ly, lz = MidwayPhysics.GetPosition(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, lx, ly + random_y, lz)
        end
        
        -- Bell collision detection
        if MidwayPhysics.IsSensorTriggered(bell) then
            MidwayPhysics.DestroyBody(bell)
            local lx, ly, lz = MidwayPhysics.GetPosition(bell)
            bell = MidwayPhysics.PoolAcquire(puck_pool, lx, ly + bell_height_offset, lz)
            Engine.AwardTickets(10, "Bell Hit")
        end
        
        -- Payout wiring
        Engine.AwardTokens(streak_multiplier, "Bell Streak")
    end)
end

