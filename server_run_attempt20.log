    print("Strongman Unloading: Platform Wobble Angle:", platform_wobble_angle)
    print("Strongman Unloading: Shock Plate Timer:", shock_plate_timer)
    print("Strongman Unloading: Puck Pool Total:", MidwayPhysics.PoolTotal(puck_pool))
    MidwayPhysics.DestroyBody(mallet)
    MidwayPhysics.DestroyBody(lever)
    MidwayPhysics.DestroyBody(puck)
    MidwayPhysics.DestroyBody(bell)
    MidwayPhysics.DestroyBody(platform)
    MidwayPhysics.DestroyBody(rail)
    MidwayPhysics.DestroyBody(spring)
    MidwayPhysics.PoolFree(puck_pool)
end
