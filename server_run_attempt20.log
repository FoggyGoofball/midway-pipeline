### Mechanic: Echo Strikes rhythm
INTENT: awards bonus tickets when the player hits the bell within a specific beat window relative to the last strike
PSEUDO:
  if IsSensorTriggered(bell) then
    current_time = GetTime()
    last_hit_time = GetLastHitTime()
    beat_window = RHYTHM_WINDOW
    if current_time - last_hit_time <= beat_window then
      streak = GetStreak() + 1
      bonus = streak * TICKET_MULTIPLIER
      Engine.AwardTickets(bonus, "Rhythm Bonus")
    else
      streak = 0
    end
    SetLastHitTime(current_time)
  end
