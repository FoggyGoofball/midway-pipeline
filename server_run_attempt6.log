        -- Calculate exponential ticket multiplier based on current streak
        if streak > 1 then
            local multiplier = streak ^ 2
            local tickets_awarded = 10 * multiplier
            
            -- Award tickets with 'strongman_streak' label
            Engine.AwardTickets(tickets_awarded, 'strongman_streak')
        end
        
        -- Reset streak counter on this win
        streak_count = 0
