        local lx, ly, lz = GetPosition(puck)
        if ly > 5.0 and ly < 12.0 then
            -- Destroy old puck and spawn new one at random height within valid tower range
            MidwayPhysics.DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, lever_lx, (lever_target_height + (streak * 0.2) + (math.random(-1.5, 1.5))), 0.5)
            -- Apply downward impulse to start new ascent
