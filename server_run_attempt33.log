            mallet_integrity = 1.0
        end

        -- Collision response between mallet and puck (Task 9)
        if puck and mallet then
            local puckPos = MidwayPhysics.GetPosition(puck)
            local malletPos = MidwayPhysics.GetPosition(mallet)
            local dist = math.sqrt((puckPos[1] - malletPos[1])^2 + (puckPos[2] - malletPos[2])^2)
            if dist < 1.0 then
                local impulse = 50.0
                MidwayPhysics.ApplyImpulse(mallet, 0, impulse, 0)
                MidwayPhysics.ApplyImpulse(puck, 0, -impulse, 0)
            end
        end

        -- Payout wiring (Task 10)
        if streak > 0 then
            Engine.AwardTokens(streak * 5, "streak_payout")
            streak = 0
        end
