local mallet_integrity = 1.0
local bell_shift_active = false
local shock_plate_cooldown = 0.0
local platform_wobble = 0.0
local lever_rotation = 0.0
local bell_sensor = nil

function OnLoadStatic()
    MidwayPhysics.SpawnStaticBox(0, 0, 0, 10, 2, 10)
    MidwayPhysics.SpawnStaticBox(0, 2, 0, 1, 1, 1)
end

function OnLoad()
    local puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)
    local mallet = MidwayPhysics.PoolAcquire(mallet_pool, 0, 1, 0)
    platform = MidwayPhysics.PoolAcquire(platform_pool, 0, 0, 0)
    lever = MidwayPhysics.PoolAcquire(lever_pool, 0, 0, 0)
    bell_sensor = MidwayPhysics.SpawnSensorSphere(0, 10, 5, 0.5)
    MidwayPhysics.SetFriction(puck, 0.5)
    MidwayPhysics.SetMass(puck, 1.0)
    MidwayPhysics.SetFriction(mallet, 0.1)
    MidwayPhysics.SetMass(mallet, 5.0)
    MidwayPhysics.SetFriction(platform, 0.0)
    MidwayPhysics.SetMass(platform, 10.0)
    MidwayPhysics.SetFriction(lever, 0.0)
    MidwayPhysics.SetMass(lever, 2.0)
    MidwayPhysics.SetFriction(bell_sensor, 0.0)
    MidwayPhysics.SetMass(bell_sensor, 0.0)
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local friction = 1.0 + MOD.heat * 0.2
        MidwayPhysics.SetFriction(puck, friction)
        local mass = 1.0 + MOD.mass * 0.5
        MidwayPhysics.SetMass(puck, mass)
        if tower_gauge_offset ~= 0 then
            MidwayPhysics.DestroyBody(puck)
            puck = MidwayPhysics.PoolAcquire(puck_pool, 0, tower_gauge_offset, 0)
            tower_gauge_offset = 0
        end
        if MidwayInput.IsActionDown("fire") then
            if mallet and MidwayPhysics.IsActive(mallet) then
                MidwayPhysics.ApplyImpulse(mallet, 0, -1000.0, 0)
            end
            if puck and MidwayPhysics.IsActive(puck) then
                local pos = MidwayPhysics.GetPosition(puck)
                if pos.y > 0.5 then
                    local impulse = MALLET_SWING_THRESHOLD * LAUNCH_FORCE
                    MidwayPhysics.ApplyImpulse(puck, 0, impulse, 0)
                end
            end
            if bell_sensor and MidwayPhysics.IsSensorTriggered(bell_sensor) then
                if not bell_shift_active then
                    bell_shift_active = true
                    MidwayPhysics.SetLinearVelocity(bell_sensor, 0, 0, 10.0)
                end
                local tickets = Engine.GetStreak() * 10
                Engine.AwardTickets(tickets, "Bell Ring")
                local tokens = Engine.GetStreak() * 5
                Engine.AwardTokens(tokens, "Bell Ring")
            end
            if shock_plate_cooldown > 0 then
                shock_plate_cooldown = shock_plate_cooldown - dt
            end
        end
        if shock_plate_cooldown <= 0 then
            shock_plate_cooldown = 0.0
        end
    end)
end

function OnUnload()
    if puck then MidwayPhysics.DestroyBody(puck) end
    if mallet then MidwayPhysics.DestroyBody(mallet) end
    if platform then MidwayPhysics.DestroyBody(platform) end
    if lever then MidwayPhysics.DestroyBody(lever) end
    if bell_sensor then MidwayPhysics.DestroyBody(bell_sensor) end
    MidwayPhysics.PoolFree(puck_pool)
    MidwayPhysics.PoolFree(mallet_pool)
    MidwayPhysics.PoolFree(platform_pool)
    MidwayPhysics.PoolFree(lever_pool)
    print("Strongman unloaded. Pools freed.")
end
