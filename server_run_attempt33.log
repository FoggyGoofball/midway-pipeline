### Mechanic: Variable Friction & Gauge Shift
INTENT: Read frame modifiers to adjust puck friction and mass, then destroy and respawn the puck at a random height when the tower gauge shifts.
PSEUDO:
  if puck then
    friction = AttractionConstants.modifiers.friction
    SetFriction(puck, friction)
    mass = AttractionConstants.modifiers.mass
    SetMass(puck, mass)
  end
  if tower_gauge_offset ~= 0 then
    DestroyBody(puck)
    local pos = PoolAcquire(puck_pool, 0, tower_gauge_offset, 0)
    puck = pos
    tower_gauge_offset = 0
  end
