local mallet_integrity = 1.0
local bell_shift_active = false
local shock_plate_cooldown = 0.0

function OnLoadStatic()
    MidwayPhysics.SpawnStaticBox(0, 0, 0, 10, 20, 10) -- Booth floor
    MidwayPhysics.SpawnStaticBox(0, 10, 0, 2, 20, 10) -- Tower base
end

function OnLoad()
    local MOD = AttractionConstants.modifiers or {}
    local puck_pool = MOD.puck_pool or "puck_pool"
    local tower_gauge_offset = 0

    -- Spawn mallet
    mallet = MidwayPhysics.SpawnDynamicCapsule(0, 0, 0, 0.5, 1.5, 1.0, 5.0)

    -- Spawn puck
    puck = MidwayPhysics.PoolAcquire(puck_pool, 0, 0, 0)

    -- Spawn bell sensor
    MidwayPhysics.SpawnSensorSphere(0, 15, 0, 1.0)

    MidwayPhysics.OnStep(function(dt)
        if puck then
            local MOD = AttractionConstants.modifiers or {}
            local friction = 1.0 + (MOD.heat or 0) * 0.2
            MidwayPhysics.SetFriction(puck, friction)
            local mass = 1.0 + (MOD.mass or 0) * 0.5
            MidwayPhysics.SetMass(puck, mass)
            if tower_gauge_offset ~= 0 then
                MidwayPhysics.DestroyBody(puck)
                puck = MidwayPhysics.PoolAcquire(puck_pool, 0, tower_gauge_offset, 0)
                tower_gauge_offset = 0
            end
        end

        if MidwayInput.IsActionDown("fire") then
            if mallet and MidwayPhysics.IsActive(mallet) then
                -- Apply swing impulse to mallet
                MidwayPhysics.ApplyImpulse(mallet, 0, -1000.0, 0)
            end
            if puck and MidwayPhysics.IsActive(puck) then
                -- Check launch threshold and apply upward impulse
                local pos = MidwayPhysics.GetPosition(puck)
                if pos.y > 0.5 then
                    local impulse = MALLET_SWING_THRESHOLD * LAUNCH_FORCE
                    MidwayPhysics.ApplyImpulse(puck, 0, impulse, 0)
                end
            end
            -- Handle echo streak decay
            if echo_streak > 0 then
                echo_streak = echo_streak - 1
            end
        end

        -- Task 9: Mallet-Puck Collision Response
        if mallet and puck and MidwayPhysics.IsActive(mallet) and MidwayPhysics.IsActive(puck) then
            local mallet_pos = MidwayPhysics.GetPosition(mallet)
            local puck_pos = MidwayPhysics.GetPosition(puck)
            
            -- Check if mallet is above puck (collision condition)
            if mallet_pos.y > puck_pos.y and mallet_pos.y < puck_pos.y + 1.0 then
                -- Check if puck is within horizontal range of mallet
                local dx = math.abs(mallet_pos.x - puck_pos.x)
                local dz = math.abs(mallet_pos.z - puck_pos.z)
                
                if dx < 1.0 and dz < 1.0 then
                    -- Apply impulse based on mallet integrity
                    local impulse = mallet_integrity * 500.0
                    MidwayPhysics.ApplyImpulse(puck, 0, impulse, 0)
                end
            end
        end

        -- Task 7: Token wagering logic for bell ring
        if bell_shift_active then
            local streak = Engine.GetStreak()
            local tokens = streak * 10
            Engine.AwardTokens(tokens, "bell_ring")
            bell_shift_active = false
        end

        -- Task 8: Shock plate cooldown
        if shock_plate_cooldown > 0 then
            shock_plate_cooldown = shock_plate_cooldown - dt
        end

    end)
end

function OnUnload()
    if mallet then
        MidwayPhysics.DestroyBody(mallet)
    end
    if puck then
        MidwayPhysics.PoolReturn(puck_pool, puck)
    end
    print("Pool total:", MidwayPhysics.PoolTotal(puck_pool))
    print("Active bodies:", MidwayPhysics.IsActive(mallet) and 1 or 0)
end
