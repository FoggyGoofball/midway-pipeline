function OnLoad()
    -- TODO [TASK_2]: shared constants table (geometry, physics, gameplay values)
    -- TODO [TASK_4]: object pool creation (MidwayPhysics.CreatePool with shape/mass/restitution)
    -- TODO [TASK_5]: round state init: declare ball counters, timers, and round variables (locals only, no physics)
    local LAUNCH_FORCE = 150.0
    local MALLET_SWING_THRESHOLD = 10.0

    -- Create object pools for pucks and mallets
    MidwayPhysics.CreatePool("puck_pool", 5, 0, {
        shape = "sphere",
        radius = 0.5,
        mass = 1.0,
        restitution = 0.3
    })
    MidwayPhysics.CreatePool("mallet_pool", 2, 0, {
        shape = "box",
        width = 1.0,
        height = 2.0,
        depth = 0.5,
        mass = 5.0
    })

    -- Initialize round state variables
    local puck = nil
    local mallet = nil
    local tower_gauge_offset = 0
    local bell_shift_active = false
    local shock_plate_cooldown = 0.0
    local mallet_integrity = 1.0
    local streak = 0

    MidwayPhysics.OnStep(function(dt)
        if puck then
            local MOD = AttractionConstants.modifiers or {}
            local friction = 1.0 + MOD.heat * 0.2
            MidwayPhysics.SetFriction(puck, friction)
            local mass = 1.0 + MOD.mass * 0.5
            MidwayPhysics.SetMass(puck, mass)
            if tower_gauge_offset ~= 0 then
                MidwayPhysics.DestroyBody(puck)
                puck = MidwayPhysics.PoolAcquire(puck_pool, 0, tower_gauge_offset, 0)
                tower_gauge_offset = 0
            end
        end
    end)
end

-- ─── OnUnload: cleanup ──────────────────────────────────────
function OnUnload()
    MidwayPhysics.DestroyBody(puck)
    MidwayPhysics.DestroyBody(mallet)
end
