-- ─── MODULE-LEVEL STATE (shared across all lifecycle functions) ──
-- DECLARE all game state variables here so they are accessible from
-- OnLoadStatic, OnLoad, OnStep, and OnUnload.
local balls = {}         -- table of ball handles
local remainingBalls = 6 -- ball counter
local currentScore = 0   -- score accumulator
local aimAngle = 0.0     -- player aim direction
local powerLevel = 1.0   -- launch power
-- ─── DETERMINISTIC MODULE STATE (injected by Skeleton Builder) ──
local mallet = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local puck = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local bell = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local platform = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local tower = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local rust_sensor = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local shock_sensor = nil  -- physics handle (spawned in OnLoadStatic/OnLoad)
local puck_pool = "puck"  -- pool name string (PoolAcquire/PoolReturn)
local bell_pool = "bell"  -- pool name string (PoolAcquire/PoolReturn)
local swing_cooldown = 0.0  -- task swing Time since last swing to prevent spam.
local puck_mass_modifier = 1.0  -- task launch Multiplier for puck mass (Weighted Puck).
local bell_offset = 0.0  -- task win Vertical shift for The Bell's Curse.
local mallet_integrity = 1.0  -- task swing Power multiplier for Sabotaged Mallet (splintering).
local echo_streak = 0  -- task launch Consecutive hits on same spot for Echo Strikes.
local tower_gauge_shift = false  -- task fail Flag indicating Tower Gauge Shift is active.

-- Module-level constants for Strongman attraction geometry and physics parameters.
-- Mallet dimensions: heavy capsule for swinging.
local MALLET_RADIUS = 0.4
local MALLET_HEIGHT = 1.2
local MALLET_MASS = 15.0
-- Puck dimensions: sphere projectile.
local PUCK_RADIUS = 0.25
local PUCK_MASS = 2.0
-- Bell dimensions: target capsule at tower top.
local BELL_RADIUS = 0.3
local BELL_HEIGHT = 0.5
-- Lever dimensions: kinematic box trigger.
local LEVER_WIDTH = 0.8
local LEVER_HEIGHT = 0.1
local LEVER_DEPTH = 0.2

-- Helper function to calculate swing impulse based on mallet properties.
-- Returns impulse vector (ix, iy, iz) for the mallet swing.
local function CalculateSwingImpulse(dt)
    local MOD = AttractionConstants.modifiers or {}
    local difficulty = 1.0 + (MOD.heat or 0) * 0.2
    local impulse_magnitude = 500.0 * mallet_integrity * difficulty
    local impulse_x = impulse_magnitude * math.sin(0.5)
    local impulse_y = impulse_magnitude * math.cos(0.5)
    local impulse_z = 0.0
    return impulse_x, impulse_y, impulse_z
end

-- ─── INVARIANT 3: OnLoadStatic → SpawnSharedBooth ──
-- ALL static geometry MUST go here
function OnLoadStatic()
    SpawnSharedBooth()
end

-- ─── INVARIANT 4: OnLoad → OnStep registration ───
-- ALL game logic and setup MUST go here
function OnLoad()
    -- Bell and Tower Geometry Setup
    local towerHandle = MidwayPhysics.SpawnStaticCylinder(0, 0, 0, 0, 2)
    local bellHandle = MidwayPhysics.SpawnStaticCapsule(0, 0, 0, 1, 1.5)
    tower = towerHandle
    bell = bellHandle

    -- SpawnStaticBox for Cracked Base wobble (platform offset)
    local crackedBaseBox = MidwayPhysics.SpawnStaticBox(0, 0, 0, 1, 1, 1)
    platform = crackedBaseBox

    -- SpawnStaticBox for Shock Plates (trigger area)
    local shockPlateBox = MidwayPhysics.SpawnStaticBox(0, 0, 0, 1, 0.1, 1)

    -- SpawnSensorBox for Shock Plate triggers
    local shockPlateSensor = MidwayPhysics.SpawnSensorBox(0, 0, 0, 1, 0.1, 1)

    -- Input handling / aiming mechanism setup
    local aimOffset = 0
    local lastInputTime = 0
    local inputCooldown = 0.2

    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers or {}
        -- Input handling logic
        if MidwayInput.IsActionDown("aim_right") then
            aimOffset = aimOffset + dt * 50
        elseif MidwayInput.IsActionDown("aim_left") then
            aimOffset = aimOffset - dt * 50
        end
        -- Clamp aim offset
        aimOffset = math.max(-2, math.min(2, aimOffset))
        -- Apply aim offset to bell handle position
        MidwayPhysics.SetPosition(bell, aimOffset, 0, 0)
    end)
end

-- ─── INVARIANT 5: OnUnload ───
function OnUnload()
    if platform then MidwayPhysics.DestroyBody(platform) end
    if tower then MidwayPhysics.DestroyBody(tower) end
    if rust_sensor then MidwayPhysics.DestroyBody(rust_sensor) end
    if shock_sensor then MidwayPhysics.DestroyBody(shock_sensor) end
    print("Cleanup complete for Strongman attraction")
end
