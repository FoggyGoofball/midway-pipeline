    -- Streak Protocol: check if puck hit bell and is still active
    local MOD = AttractionConstants.modifiers
    local lx, ly, lz = MidwayPhysics.GetPosition(puck)
    local bell_lx, bell_ly, bell_lz = MidwayPhysics.GetPosition(bell)
    
    -- Check if puck reached bell height (accounting for bell curse offset)
    if ly > bell_ly then
        -- Successful strike: award tickets with streak multiplier
        local streak = MidwayPhysics.GetStreak()
        local base_tickets = 10
        local streak_bonus = base_tickets * streak
        
        -- Award tickets for the win
        MidwayPhysics.Engine.AwardTickets(streak_bonus, 'WIN')
        
        -- Award tokens for successful swing
        MidwayPhysics.Engine.AwardTokens(1, 'BONUS')
        
        -- Update streak state
        current_streak = current_streak + 1
        is_streak_active = true
        
        -- Reset streak on failure (puck destroyed or missed)
    else
        current_streak = 0
        is_streak_active = false
    end
    
    -- Apply modifier effects
    local difficulty = 1.0 + MOD.heat * 0.2
    MidwayPhysics.SetFriction(puck, 0.5 * difficulty)
    
    -- Bell's Curse: shift bell position
    if MOD.bell_curse then
        bell_position_offset = bell_position_offset + MOD.bell_curse * 0.1
        MidwayPhysics.MoveKinematic(bell, bell_lx, bell_ly + bell_position_offset, bell_lz, 0.016)
    end
    
    -- Cracked Base: platform wobble
    if MOD.cracked_base then
        platform_wobble_accum = platform_wobble_accum + MOD.cracked_base * 0.05
    end
    
    -- Tower Gauge Shift: random height change
    if MOD.tower_gauge_shift and math.random(1, 100) < 10 then
        MidwayPhysics.DestroyBody(puck)
        local new_height = bell_ly + math.random(-5, 5)
        puck = MidwayPhysics.PoolAcquire(puck_pool, 0, new_height, 0)
        MidwayPhysics.SetMass(puck, 1.0)
    end
)
