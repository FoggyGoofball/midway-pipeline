            local particle = MidwayPhysics.SpawnDynamicSphere(lx, ly, lz, 0.15, 0.0)
            MidwayPhysics.SetGravityFactor(particle, 0.0)
            MidwayPhysics.SetLinearDamping(particle, 2.0)
            MidwayPhysics.SetAngularDamping(particle, 2.0)
            MidwayPhysics.SetFriction(particle, 0.0)
            MidwayPhysics.SetRestitution(particle, 0.0)
            MidwayPhysics.SetMass(particle, 0.0)
            MidwayPhysics.SetLinearVelocity(particle, 0, 0, 0)
            MidwayPhysics.SetLinearVelocity(particle, 0, 0.5, 0)
            -- Destroy particle after 1.0 second (approx 30 steps at 30Hz)
