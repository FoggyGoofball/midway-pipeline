                MidwayPhysics.MoveKinematic(particle, lx, ly - 0.03 * dt, lz, dt)
                MidwayPhysics.OnStep(function(dt2)
                    MidwayPhysics.DestroyBody(particle)
                end)
            end)
        end
    end
