    local MOD = AttractionConstants.modifiers
    local bell_hit_count = 0
    local last_hit_pos = nil
    local last_hit_height = 0
    MidwayPhysics.OnStep(function(dt)
        -- Read modifiers every frame
        local rust = MOD.rusty_rails
        local bell_curse = MOD.bell_curse
        local tower_gauge = MOD.tower_gauge_shift
        local counter_weight = MOD.counter_weight_springs
        local cracked_base = MOD.cracked_base

        -- Handle Tower Gauge Shift: destroy old puck, spawn new at random height
        if tower_gauge and tower_gauge > 0 then
            if puck and MidwayPhysics.IsActive(puck) then
                MidwayPhysics.DestroyBody(puck)
                puck = nil
            end
            local new_height = 5 + math.random(0, 10)
            puck = MidwayPhysics.PoolAcquire(puck_pool, 0, new_height, 0)
            MidwayPhysics.SetFriction(puck, 0.1)
            MidwayPhysics.SetGravityFactor(puck, 0.95)
            tower_gauge = 0 -- consume modifier
        end

        -- Handle Bell's Curse: shift bell position randomly
        if bell_curse and bell_curse > 0 then
            local offset = math.random(-0.5, 0.5)
            MidwayPhysics.MoveKinematic(bell, 0, bell.y + offset, 0, dt)
            bell_curse = 0 -- consume modifier
        end

        -- Handle Cracked Base: offset platform aim
        if cracked_base and cracked_base > 0 then
            platform_wobble_accum = platform_wobble_accum + cracked_base * 0.01
            cracked_base = 0 -- consume modifier
        end

        -- Handle Rusty Rails: apply variable friction
        if rust and rust > 0 then
            MidwayPhysics.SetFriction(puck, 0.8 + rust * 0.1)
            rust = 0 -- consume modifier
        end

        -- Handle Counter-Weight Springs: randomize mallet rebound impulse
        if counter_weight and counter_weight > 0 then
            local impulse = math.random(-5, 5)
            MidwayPhysics.ApplyImpulse(mallet, 0, 0, impulse)
            counter_weight = 0 -- consume modifier
        end

        -- Check mallet impact via sensor
        if MidwayPhysics.IsSensorTriggered(mallet) then
            local lx, ly, lz = MidwayPhysics.GetPosition(puck)
            local bell_lx, bell_ly, bell_lz = MidwayPhysics.GetPosition(bell)

            -- Check puck height against bell
            if ly > bell_ly then
                -- Successful hit: award tickets with streak multiplier
                local streak = Engine.GetStreak()
                local base_tickets = 10
                local tickets = base_tickets * streak
                Engine.AwardTickets(tickets, 'strongman_hit')

                -- Reset streak-related state
                bell_hit_count = bell_hit_count + 1
                last_hit_pos = lz
                last_hit_height = ly
                is_streak_active = true
                current_streak = current_streak + 1
            else
                -- Missed hit: reset streak
                is_streak_active = false
                current_streak = 0
                bell_hit_count = 0
            end
        end
    end)
