local mallet
local platform
local sensor_hit_zone
local swing_cooldown = 0
local echo_hits = 0

function OnLoad()
    mallet = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, 0.5, 1)
    platform = MidwayPhysics.SpawnKinematicBox(0, 0, 0, 2, 0.2, 2)
    sensor_hit_zone = MidwayPhysics.SpawnSensorBox(0, 0, 0, 1, 0.1, 1)
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers or {}
        if MidwayInput.IsActionDown("fire") and swing_cooldown <= 0 then
            MidwayPhysics.ApplyImpulse(mallet, 0, -10, 0)
            swing_cooldown = 0.2
        end
        if MidwayPhysics.IsSensorTriggered(sensor_hit_zone) then
            echo_hits = echo_hits + 1
            local wobble = (math.random() * 2 - 1) * (MOD.wobble or 0.5)
            MidwayPhysics.MoveKinematic(platform, 0, wobble, 0, dt)
        end
    end)
end

function OnUnload()
    MidwayPhysics.DestroyBody(mallet)
    MidwayPhysics.DestroyBody(platform)
    MidwayPhysics.DestroyBody(sensor_hit_zone)
end
