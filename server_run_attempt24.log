    local mallet_integrity = 1.0
    local mallet_handle = MidwayPhysics.SpawnDynamicBox(0, 0, 0, 1, 1, 1, 5)
    local puck_handle = MidwayPhysics.SpawnDynamicSphere(0, 0, 2, 0.2, 1)
