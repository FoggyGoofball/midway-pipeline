local MOD = AttractionConstants.modifiers or {}

function OnLoad()
    -- Task 4: Spawn dynamic mallet
    mallet = MidwayPhysics.SpawnDynamicBox(0, 0, 0, 0.3, 0.6, 0.2, 1.0)
    -- Task 5: Spawn dynamic puck
    puck = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, 0.15, 0.5)
    -- Task 6: Spawn bell tower (static) and bell (dynamic)
    bell_tower = MidwayPhysics.SpawnStaticCylinder(0, 0, 0, 0.5, 2.0, 0.5)
    bell = MidwayPhysics.SpawnDynamicSphere(0, 0, 3.0, 0.3, 0.1)
    -- Task 7: Spawn kinematic base platform
    platform = MidwayPhysics.SpawnKinematicBox(0, 0, 0, 2.0, 0.1, 4.0)
    -- Sensor for shock plates
    shock_plate_sensor = MidwayPhysics.SpawnSensorBox(0, 0.5, 0, 1.0, 0.1, 2.0)
end

function OnStep(dt)
    -- Task 4: Mallet swing
    if MidwayInput.IsActionDown("fire") and swing_cooldown <= 0 then
        MidwayPhysics.ApplyImpulse(mallet, 0, -10, 0)
        swing_cooldown = 0.2
    end

    -- Task 5: Launch puck when mallet hits it (simple collision proxy via position check)
    local mallet_pos = MidwayPhysics.GetPosition(mallet)
    local puck_pos = MidwayPhysics.GetPosition(puck)
    if mallet_pos.z > puck_pos.z - 0.2 and puck_pos.z < puck_pos.y then -- simplistic launch trigger
        MidwayPhysics.ApplyImpulse(puck, 0, 0, 8)
    end

    -- Task 6: Bell shift (bell_target_y declared but unused -> use it)
    if bell_target_y then
        local bell_pos = MidwayPhysics.GetPosition(bell)
        MidwayPhysics.SetLinearVelocity(bell, 0, (bell_target_y - bell_pos.y) * 5, 0)
    end

    -- Task 7: Cracked Base Wobble
    if MidwayPhysics.IsSensorTriggered(shock_plate_sensor) then
        local wobble = MidwayPhysics.GetRandomValue(-WobbleMax, WobbleMax)
        MidwayPhysics.MoveKinematic(platform, 0, wobble, 0, dt)
    end

    -- Echo hits sensor
    if MidwayPhysics.IsSensorTriggered(sensor_hit_zone) then
        echo_hits = echo_hits + 1
    end
end

function OnUnload()
    MidwayPhysics.DestroyBody(mallet)
    MidwayPhysics.DestroyBody(puck)
    MidwayPhysics.DestroyBody(bell_tower)
    MidwayPhysics.DestroyBody(bell)
    MidwayPhysics.DestroyBody(platform)
    MidwayPhysics.DestroyBody(shock_plate_sensor)
end
