        -- Sabotaged Mallet: Reduce mass and apply impulse if integrity is low
        if mallet_integrity < 0.5 then
            MidwayPhysics.SetMass(mallet, mallet_integrity * 5 * 0.8)
            MidwayPhysics.ApplyAngularImpulse(mallet, 0, 0, -50)
        end
        
        -- Sabotaged Mallet: Swap head mesh if integrity is critical
        if mallet_integrity < 0.2 then
            MidwayPhysics.SpawnDynamicMesh(mallet, 0, 0, 0, 0, "splintered_head.mesh")
            MidwayPhysics.PoolReturn("mallet_head", mallet) -- Placeholder for pool logic
        end

        -- Swing mechanics
        if MidwayInput.IsActionDown("fire") and streak_count <= 0 then
            MidwayPhysics.ApplyImpulse(mallet, 0, -10, 0)
            streak_count = 1
        end
        
        -- Puck launch (simplified)
        if streak_count > 0 then
            streak_count = streak_count - 1
        end

        -- Bell tower shift
        if bell_target_y ~= 0 then
            -- Logic to move bell would go here
            bell_target_y = 0
        end
    end)
end

function OnUnload()
    if mallet then
        MidwayPhysics.DestroyBody(mallet)
    end
end
