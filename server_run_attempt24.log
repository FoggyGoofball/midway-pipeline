local mallet_integrity = 1.0
local streak_count = 0
local bell_target_y = 0.0

function OnLoadStatic()
    MidwayPhysics.SpawnStaticBox(0, 0, 0, 2, 2, 2)
    MidwayPhysics.SpawnStaticCylinder(0, 0, 0, 1, 1)
    MidwayPhysics.SpawnStaticCylinder(0, 0, 5, 0.5, 0.5)
end

function OnLoad()
    local mallet = MidwayPhysics.SpawnDynamicBox(0, 0, 0, 1, 1, 1, 5)
    local puck = MidwayPhysics.SpawnDynamicSphere(0, 0, 2, 0.2, 1)
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers or {}
        
        -- Task 7: Cracked Base wobble effect
        if streak_count > 0 then
            local offset = math.sin(streak_count * 0.5) * 0.1
            MidwayPhysics.MoveKinematic(puck, 0, 0, 2 + offset, dt)
        end

        -- Task 1: Sabotaged Mallet Degradation
        if mallet_integrity < 0.5 then
            MidwayPhysics.SetMass(mallet, mallet_integrity * 0.8)
            MidwayPhysics.ApplyAngularImpulse(mallet, 0, 0, -50)
            if mallet_integrity < 0.2 then
                MidwayPhysics.SpawnDynamicMesh(0, 0, 0, 0, 1, "splintered_head.mesh")
                MidwayPhysics.PoolReturn("mallet_head", mallet)
            end
        end

        if MidwayInput.IsActionDown("fire") and swing_cooldown <= 0 then
            MidwayPhysics.ApplyImpulse(mallet, 0, -10, 0)
            swing_cooldown = 0.2
        end

        if MidwayPhysics.IsSensorTriggered(sensor_hit_zone) then
            echo_hits = echo_hits + 1
            streak_count = streak_count + 1
        end

        -- Task 6: Bell tower shift
        bell_target_y = bell_target_y + 0.01
        if bell_target_y > 5 then
            bell_target_y = 5
        end
    end)
end

function OnUnload()
    MidwayPhysics.DestroyBody(mallet)
    MidwayPhysics.DestroyBody(puck)
end
