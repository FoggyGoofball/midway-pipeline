    -- [TASK_9_INSERT_HOOK] -- dynamic difficulty tuning: recompute heat/luck/sleight-of-hand from current streak on score events
    -- Implement Sabotaged Mallet degradation via SetMass/ApplyAngularImpulse and splintering via mesh swaps
    if self.malletHead and self.malletHead:IsValid() then
        -- Reduce effective power by decreasing mass on head impact (simulates wear/splintering)
        local degradationLevel = self:GetAttribute("DegradationLevel") or 0
        if degradationLevel > 0 and self.malletHead:GetMass() > 0 then
            -- Reduce mass by 5% per degradation level, capped at 50% original
            local massReduction = math.min(0.5, degradationLevel * 0.05)
            local currentMass = self.malletHead:GetMass()
            local newMass = currentMass * (1 - massReduction)
            if newMass < currentMass then
                self.malletHead:SetMass(newMass)
            end
        end

        -- Apply angular impulse to simulate splintering/instability on high-velocity hits
        local velocity = self.malletHead:GetLinearVelocity()
        if velocity and velocity.Magnitude > 15 then
            local impulseVector = self.malletHead:GetRightVector() * velocity.Magnitude * 0.01
            if impulseVector.Magnitude > 0 then
                self.malletHead:ApplyAngularImpulse(impulseVector, true)
            end
        end

        -- Handle head splintering via conditional mesh swap
        if degradationLevel >= 3 and self.malletHead:GetClass() == "MalletHead" then
            -- Swap to a splintered mesh if degradation is high enough
            local splinteredMesh = self.malletHead:GetMesh()
            if splinteredMesh then
                local splinteredMeshName = splinteredMesh:GetName()
                if splinteredMeshName ~= "splintered_mallet_head" then
                    local splinteredMeshAsset = "models/props_phx/tools/splintered_mallet_head"
                    if splinteredMeshAsset then
                        self.malletHead:SetMesh(splinteredMeshAsset)
                        -- Trigger visual effect for splintering
                        if self.splinterEffect then
                            self.splinterEffect:Fire()
                        end
                    end
                end
            end
        end
