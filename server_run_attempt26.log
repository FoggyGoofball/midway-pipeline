### Mechanic: Echo Strikes
INTENT: awards bonus points when the player hits the bell within a specific rhythmic window after a previous successful hit
PSEUDO:
  if IsSensorTriggered(bell_sensor) then
    current_time = GetTime()
    last_hit_time = echo_hit_count > 0 and last_hit_time or current_time
    window = RHYTHM_WINDOW
    if current_time - last_hit_time < window then
      echo_hit_count = echo_hit_count + 1
      bonus = echo_hit_count * ECHO_MULTIPLIER
      Engine.AwardTokens(bonus, "Echo Bonus")
    else
      echo_hit_count = 0
    end
    last_hit_time = current_time
  end
