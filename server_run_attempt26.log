            local new_x = pos.x + puck_velocity.x * dt
            local new_y = pos.y + puck_velocity.y * dt
            local new_z = pos.z + puck_velocity.z * dt
            MidwayPhysics.SetLinearVelocity(puck_handle, puck_velocity.x, puck_velocity.y, puck_velocity.z)
        end

