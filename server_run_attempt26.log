### Mechanic: Frame State & Sabotage
INTENT: Read global modifiers, apply friction/damping, handle shock plates, and shift the bell height each physics frame.
PSEUDO:
  -- Read static modifiers from AttractionConstants
  heat_mod = AttractionConstants.modifiers.heat
  luck_mod = AttractionConstants.modifiers.luck
  sleight_mod = AttractionConstants.modifiers.sleight
  -- Apply friction based on heat modifier to the puck
  puck_friction = base_friction * heat_mod
  SetFriction(puck, puck_friction)
  -- Apply angular damping to mallet based on sleight modifier
  mallet_damping = base_damping * sleight_mod
  SetAngularDamping(mallet_handle, mallet_damping)
  -- Handle shock plate timer logic
  if shock_plate_timer > 0 then
    shock_plate_timer = shock_plate_timer - dt
    if shock_plate_timer <= 0 then
      shock_plate_timer = 0
      ApplyImpulse(tower_base, 0, 0, 0) -- Reset base wobble
    end
  end
  -- Shift bell height based on luck modifier
  bell_shift = luck_mod * bell_height_offset
  MoveKinematic(bell_sensor, bell.x, bell.y + bell_shift, bell.z, dt)
