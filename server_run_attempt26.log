      Engine.AwardTickets(streak_mult * WIN_TICKETS, "win")
      Engine.AwardTokens(streak_mult * WIN_TOKENS, "win")
      streak_active = false
    else
      Engine.AwardTickets(streak_mult * LOSS_TICKETS, "loss")
      Engine.AwardTokens(streak_mult * LOSS_TOKENS, "loss")
      TriggerStreakProtocol()
    end
  end
