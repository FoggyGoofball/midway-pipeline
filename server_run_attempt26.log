function OnLoad()
    -- Shared constants table (geometry, physics, gameplay values)
    local constants = {
        gravity = -9.8,
        friction = 0.5,
        restitution = 0.8,
        swing_speed = 20,
        mallet_integrity = 1.0,
        lever_angle = 0,
        bell_height_offset = 2,
        base_wobble_offset = 0,
        puck_velocity = {0, 0, 0},
        tower_base = {0, 0, 0},
        lever_pivot = {0, 0, 0},
        lever_arm = {0, 0, 0},
    }

    -- Spawn Static Geometry (Tower, Lever, Pivot)
    local tower_handle = MidwayPhysics.SpawnStaticBox(0, 0, 0, 2, 4, 2)
    local pivot_handle = MidwayPhysics.SpawnStaticBox(0, 2, 0, 1, 1, 1)
    local lever_handle = MidwayPhysics.SpawnStaticBox(0, 2, 0, 1, 1, 3)

    -- Spawn Dynamic Gameplay Objects (Mallet, Puck)
    local mallet_handle = MidwayPhysics.SpawnDynamicCapsule(0, 1, 0, 0.5, 0.5, 1.0)
    local puck_handle = MidwayPhysics.SpawnDynamicSphere(0, 0.5, 0, 0.3, 0.5)

    -- Register Per-Step Callback
    MidwayPhysics.OnStep(function(dt)
        -- Read local MOD (mallet_integrity) every frame
        local MOD = constants.mallet_integrity

        -- Check for swing input using correct API
        if MidwayInput.IsActionDown("fire") then
            -- Calculate swing speed based on integrity
            local swing_speed = MOD * constants.swing_speed
            -- Apply linear velocity to mallet handle
            MidwayPhysics.SetLinearVelocity(mallet_handle, 0, swing_speed, 0)
        end

        -- Reset mallet velocity if not swinging (simple damping)
        local vel = MidwayPhysics.GetVelocity(mallet_handle)
        if vel.y < 5 then
            MidwayPhysics.SetLinearVelocity(mallet_handle, 0, vel.y * 0.9, 0)
        end
    end)
end
