    bell_height_offset = 0
    base_wobble_offset = 0

    -- Spawn the mallet (static)
    local mallet_handle = MidwayPhysics.SpawnStaticBox(0, 0, 0, 1, 2, 0.5)

    -- Spawn the puck (dynamic)
    local puck_handle = MidwayPhysics.SpawnDynamicSphere(0, 0, 0, 0.2)

    -- Spawn the tower (static)
    local tower_handle = MidwayPhysics.SpawnStaticCylinder(0, 0, 5, 1, 3)

    -- Spawn the lever (kinematic)
    local lever_handle = MidwayPhysics.SpawnKinematicCapsule(0, 0, 10, 0.5, 0.5)

    -- Helper function to spawn puck at current tower height
    function SpawnPuckAtTowerHeight(tower_height)
        local puck_handle = MidwayPhysics.SpawnDynamicSphere(0, tower_height, 0, 0.2)
        return puck_handle
    end

    -- Register the per-step callback
    MidwayPhysics.OnStep(function(dt)
        -- Update game logic here
        if turn_active then
            -- Apply puck velocity
