                streak_wager = 0
                is_streak_active = false
                Engine.AwardTokens(0, "fail_penalty")
                MidwayPhysics.PoolReturn("puck_pool", puck_handle)
                puck_handle = MidwayPhysics.PoolAcquire("puck_pool", 0, 0, 0)
            end
        end

        if shock_plate_sensor then
            if MidwayPhysics.IsSensorTriggered(shock_plate_sensor) then
                streak_wager = 0
                is_streak_active = false
                Engine.AwardTokens(0, "fail_penalty")
                MidwayPhysics.PoolReturn("puck_pool", puck_handle)
                puck_handle = MidwayPhysics.PoolAcquire("puck_pool", 0, 0, 0)
            end
        end

        -- Apply swing impulse when fire is pressed
        if MidwayInput.IsActionDown("fire") and mallet_handle then
            local impulse = 50.0 * 1.0 * mallet_integrity
            MidwayPhysics.ApplyImpulse(mallet_handle, 0, impulse, 0)
        end
        
        -- Apply tower gauge shift (bell offset) based on sleight_of_hand
        bell_offset = bell_offset + MOD.sleight_of_hand * 0.01
        
        -- Apply platform wobble based on karma
        platform_wobble = platform_wobble + MOD.karma * 0.005
        
        -- Check if puck hit the bell
        if puck_handle then
            local lx, ly, lz = MidwayPhysics.GetPosition(puck_handle)
            if ly >= 8.0 + bell_offset then
                local streak = Engine.GetStreak()
                Engine.AwardTickets(streak * 10, 'WIN')
                Engine.AwardTokens(streak * 5, 'BONUS')
                bell_offset = bell_offset + 1.0 * 0.1
            end
        end

        if bell_handle then
            local bell_y, _, _ = MidwayPhysics.GetPosition(bell_handle)
            local bell_y_final = bell_y + bell_offset
        else
            local bell_y_final = bell_height
        end
        
        if puck_handle then
            local puck_y, _, _ = MidwayPhysics.GetPosition(puck_handle)
            local streak = Engine.GetStreak()
            if puck_y >= bell_y_final then
                local base_tickets = 10
                local total_tickets = base_tickets * streak
                Engine.AwardTickets(total_tickets, 'WIN')
                local bell_trigger_active = true
                bell_offset = bell_offset + 1.0 * 0.1
            end
        end

        -- Mallet swing input handling
        if MidwayInput.IsActionDown("fire") then
            -- Calculate swing power based on power_up/power_down inputs
            local power = 1.0
            if MidwayInput.IsActionDown("power_up") then
                power = power + 0.1
            elseif MidwayInput.IsActionDown("power_down") then
                power = power - 0.1
            end
            -- Apply swing impulse scaled by power and mallet integrity
            MidwayPhysics.ApplyImpulse(mallet_handle, 0, power * 500 * mallet_integrity, 0)
        end

        local MOD = AttractionConstants.modifiers
        local RHYTHM_PERIOD = 2.0
        local RHYTHM_WINDOW = 0.5
        local MASS_PENALTY = 0.15
        if MidwayInput.IsActionDown("fire") then
            local bell_y, _, _ = MidwayPhysics.GetPosition(bell_handle)
            local window = bell_y % RHYTHM_PERIOD
            if window < RHYTHM_WINDOW then
                echo_hit_count = echo_hit_count + 1
                local current_mass = 1.0
                if puck_handle then
