        local _, _, _ = MidwayPhysics.GetVelocity(mallet_handle)
        MidwayPhysics.ApplyImpulse(mallet_handle, 0, 0, 50 * mallet_integrity)
    end
end
function OnLoad()
    local MOD = AttractionConstants.modifiers
    mallet_handle = MidwayPhysics.SpawnDynamicSphere(0, 0, 2, 1.0)
    bell_handle = MidwayPhysics.SpawnDynamicSphere(0, 0, 10, 1.0)
    platform_handle = MidwayPhysics.SpawnStaticBox(0, 0, 0, 10, 1, 10)
    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        apply_swing_impulse(dt)
        if bell_handle and MidwayPhysics.IsActive(bell_handle) then
            local pos = MidwayPhysics.GetPosition(bell_handle)
            if pos[3] < bell_height then
                MidwayPhysics.SetLinearVelocity(bell_handle, 0, 0, 5 * MOD.engine_mod_nerve)
            end
        end
    end)
end
function OnUnload()
    if mallet_handle then MidwayPhysics.DestroyBody(mallet_handle) end
    if bell_handle then MidwayPhysics.DestroyBody(bell_handle) end
    if platform_handle then MidwayPhysics.DestroyBody(platform_handle) end
end
