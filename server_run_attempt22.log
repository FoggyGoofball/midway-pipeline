                    local current_mass = puck_mass * (1 - (echo_hit_count * MASS_PENALTY))
                    MidwayPhysics.SetMass(puck_handle, current_mass)
                end
            end
        end
    end)
end

function OnUnload()
    if mallet_handle then MidwayPhysics.DestroyBody(mallet_handle) end
    if puck_handle then MidwayPhysics.DestroyBody(puck_handle) end
    if bell_handle then MidwayPhysics.DestroyBody(bell_handle) end
    if shock_plate_sensor then MidwayPhysics.DestroyBody(shock_plate_sensor) end
end
