    MidwayPhysics.OnStep(function(dt)
        local MOD = AttractionConstants.modifiers
        local base_friction = 0.5
        local random_tension = 0.1
        local spawn_offset = 0.0

        if MOD then
            base_friction = base_friction + (MOD.friction or 0)
            random_tension = random_tension + (1.0 or 0)
            spawn_offset = spawn_offset + (1.0 or 0)
        end

        -- Apply variable friction to the puck track
        if PuckTrack then
            PuckTrack.friction = base_friction
        end

        -- Randomize counter-weight spring tension on the lever
        if Lever then
            Lever.spring_tension = Lever.spring_tension + (math.random(-random_tension, random_tension) or 0)
        end

