### Mechanic: Dynamic Modifier Application
INTENT: reads AttractionConstants.modifiers per frame to adjust friction, mass, and position shifts before applying swing impulses
PSEUDO:
  local mod = AttractionConstants.modifiers
  if IsSensorTriggered(rail_sensor) then
    SetFriction(puck_handle, mod.friction)
    ApplyImpulse(puck_handle, 0, mod.rust_impulse_y, 0)
  end
  if IsActionDown("fire") then
    local impulse = mod.swing_power * mallet_integrity
    ApplyImpulse(mallet_handle, 0, impulse, 0)
  end
  bell.y = bell.y + mod.bell_shift
  platform.x = platform.x + mod.wobble_shift
